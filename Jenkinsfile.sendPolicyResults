@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties(
  [
    parameters (
      [
        string (
          name: 'releaseVersion',
          defaultValue: '',
          description: 'The version number for the product, like "52"'
        )
      ]
    )
  ]
)

pipeline {
  agent { label 'zion-small' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Send Policy Results to Corporate Legal and Security Teams') {
      steps {
        sendPolicyResults(params.releaseVersion)
      }
    }
  }
}
