<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonatype.insight.brain</groupId>
    <artifactId>insight-brain</artifactId>
    <version>1.201.0-SNAPSHOT</version>
  </parent>
  <artifactId>nexus-mtiq-functional-test</artifactId>

  <properties>
    <skip.functional.tests>false</skip.functional.tests>
    <clm.skip>true</clm.skip>
    <it.includes>**/*Test.*</it.includes>
    <selenide.timeout>4000</selenide.timeout>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>${it.includes}</include>
          </includes>
          <trimStackTrace>false</trimStackTrace>
          <skip>false</skip>
          <skipITs>${skip.functional.tests}</skipITs>
          <!-- 0.38C means 0.38 x number-of-CPUs:
                8 CPUs -> 3 forks
               16 CPUs -> 6 forks
           -->
          <forkCount>0.38C</forkCount>
          <reuseForks>true</reuseForks>
          <forkedProcessTimeoutInSeconds>0</forkedProcessTimeoutInSeconds>
          <systemPropertyVariables>
            <slowmo.enable>true</slowmo.enable>
            <selenide.browserSize>1400x1050</selenide.browserSize>
            <selenide.timeout>${selenide.timeout}</selenide.timeout>
            <browser>chrome</browser>
            <!-- Used by the test MTIQ server to set the work directory (to not use the same work dir across all forks). -->
            <test.forkId>#${surefire.forkNumber}</test.forkId>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

