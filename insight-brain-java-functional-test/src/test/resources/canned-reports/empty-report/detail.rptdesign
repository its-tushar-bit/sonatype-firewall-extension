            <property name="dataSource">summary</property>
            <method name="open"><![CDATA[index = 0;

var total = Math.max(1, summary.totalArtifactCount);

fractions = [];
fractions.push(summary.knownArtifactCount / total);
if (summary.totalArtifactCount > summary.knownArtifactCount) {
	fractions.push((summary.totalArtifactCount - summary.knownArtifactCount) / total);
}

// The PDF/SVG renderer crashes if any slice has zero size
for (var i = 0; i < fractions.length; i++) {
	fractions[i] = Math.max(0.000001, fractions[i]);
}
]]></method>
            <method name="fetch"><![CDATA[if (index >= fractions.length) {
	return false;
}

row["category"] = index;
row["count"] = fractions[index];

index++;

return true;
]]></method>
