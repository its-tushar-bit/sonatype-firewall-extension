@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties(
  [
    parameters (
      [
        string (
          name: 'releaseVersion',
          defaultValue: '',
          description: 'The version number for the product, like "52"'
        )
      ]
    )
  ]
)

pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timestamps()
  }
  stages {
    stage('Release JIRA Version') {
      steps {
        releaseJiraVersion('brain', "${params.releaseVersion}")
      }
    }
  }
  post {
    success {
      slackSend color: 'good', channel: '#iq', message: "@lifecycle-pm IQ server release ${params.releaseVersion} is available, please send the notification to the clm-announcements list."
    }
  }
}
