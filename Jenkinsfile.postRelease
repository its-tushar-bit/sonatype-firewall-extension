@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties([
    parameters([
      string(name: 'releaseVersion', defaultValue: '',description: 'The version number for the product, like "1.118.0-01"'),
    ])
])

pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Update IQ Server Test Instance') {
      steps {
        build('job': 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/staging',
            parameters: [string(name: 'IQ_VERSION', value: 'latest')])

        build('job': 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/staging')
      }
    }
    stage('Update IQ Server Production Instance') {
      steps {
        build('job': 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/production',
            parameters: [string(name: 'IQ_VERSION', value: 'latest')])

        build('job': 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/production')
      }
    }
    stage('Publish IQ Server Helm Chart') {
      steps {
        build(
          job: 'integrations/cloud/Helm3 Charts/Main Release Build',
          parameters: [
            string(name: 'chart', value: 'nexus-iq-server'),
            string(name: 'appVersion', value: params.releaseVersion.replaceAll(/-.*/, '')),
          ]
        )
      }
    }
    stage('Create Post IQ Release Integrations Team Jira Tickets') {
      steps {
        createIntegrationTicketsAfterIQRelease(params.releaseVersion)
      }
    }
  }
}

def createIntegrationTicketsAfterIQRelease(String releaseVersion) {
  List<Map> tickets = getTickets(releaseVersion)
  tickets.each { Map fields ->
    def newIssue = jiraNewIssue issue: [fields: fields], site: 'issues.sonatype.com'
    echo "New issue created: ${newIssue.data.key}"
  }
}

