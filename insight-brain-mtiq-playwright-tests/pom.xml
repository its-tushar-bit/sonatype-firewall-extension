<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonatype.insight.brain</groupId>
    <artifactId>insight-brain</artifactId>
    <version>1.207.0-SNAPSHOT</version>
    <!-- Required when this folder is opened alone so Maven / Java LS resolve the reactor and dependencyManagement. -->
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>insight-brain-mtiq-playwright-tests</artifactId>

  <!--
    Multi-tenant (MTIQ) Playwright UI tests. Split out of insight-brain-playwright-test so that
    nexus-mtiq-server (with its @Primary beans and @ManagementContextConfiguration classes) is NOT
    on the single-tenant Playwright classpath. Shared Playwright infrastructure (AbstractPlaywrightTest,
    page objects, utils, LoginPage, category markers) is consumed from the insight-brain-playwright-test
    test-jar; MTIQ-only harness code (AbstractMtiqUiTest, Mtiq* page objects) lives here.
  -->
  <properties>
    <skip.functional.tests>false</skip.functional.tests>
    <clm.skip>true</clm.skip>
    <it.includes>**/*Test.*</it.includes>
    <!-- 0.5C caps parallel forks to avoid overwhelming Docker with concurrent Postgres startups. -->
    <failsafe.forkCount>0.5C</failsafe.forkCount>
    <playwright.version>1.62.0</playwright.version>
    <!-- Playwright defaults (override with -Dplaywright.headless=false for headed mode) -->
    <playwright.headless>true</playwright.headless>
    <playwright.slowMo>0</playwright.slowMo>
    <!-- Trace capture: 'on-failure' (default) keeps reports small; 'always' captures every test. -->
    <playwright.trace>on-failure</playwright.trace>
    <!-- When true, tests that call playwrightManualPauseIfEnabled() block for Playwright Inspector. -->
    <playwright.manualPause>false</playwright.manualPause>
    <!--
      JUnit 4 @Category filtering, surfaced through Maven so CI can target specific suites.
      Empty = no filtering (run every MTIQ test in this module).
    -->
    <failsafe.groups></failsafe.groups>
    <failsafe.excludedGroups></failsafe.excludedGroups>
  </properties>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- No unit tests here; Playwright UI tests run under Failsafe. -->
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>${it.includes}</include>
          </includes>
          <groups>${failsafe.groups}</groups>
          <excludedGroups>${failsafe.excludedGroups}</excludedGroups>
          <trimStackTrace>false</trimStackTrace>
          <skip>false</skip>
          <skipITs>${skip.functional.tests}</skipITs>
          <reuseForks>true</reuseForks>
          <forkedProcessTimeoutInSeconds>3600</forkedProcessTimeoutInSeconds>
          <forkCount>${failsafe.forkCount}</forkCount>
          <!--
            Inline add-opens from jvm.options (omit enable-native-access: crashes JDK 25 forks).
            No @{argLine}: Playwright forks are excluded from JaCoCo coverage.
          -->
          <argLine>
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.security=ALL-UNNAMED
            --add-opens=java.base/sun.security.rsa=ALL-UNNAMED
            --add-opens=java.base/sun.security.x509=ALL-UNNAMED
            --add-opens=java.base/sun.security.util=ALL-UNNAMED
            --add-opens=java.xml/com.sun.org.apache.xerces.internal.jaxp.datatype=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            -XX:+HeapDumpOnOutOfMemoryError
            -XX:HeapDumpPath=${project.build.directory}/
          </argLine>
          <systemPropertyVariables>
            <!-- Used by the test IQ server to set the work directory (to not use the same work dir across all forks). -->
            <test.forkId>#${surefire.forkNumber}</test.forkId>
            <!-- Playwright configuration -->
            <playwright.version>${playwright.version}</playwright.version>
            <playwright.headless>${playwright.headless}</playwright.headless>
            <playwright.slowMo>${playwright.slowMo}</playwright.slowMo>
            <playwright.trace>${playwright.trace}</playwright.trace>
            <playwright.manualPause>${playwright.manualPause}</playwright.manualPause>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

