# Reference values for local development against insight-brain.
# These are NOT read at runtime — the extension stores its config in chrome.storage
# via the Options page. Kept here as a quick-copy reference for reviewers.

IQ_URL=http://localhost:8070
IQ_USER_CODE=your-user-token-code
IQ_PASS_CODE=your-user-token-pass
IQ_VRM_NAME=browser-ext-vrm
