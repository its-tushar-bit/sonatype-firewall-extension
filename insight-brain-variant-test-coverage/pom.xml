<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonatype.insight.brain</groupId>
    <artifactId>insight-brain</artifactId>
    <version>1.207.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>insight-brain-variant-test-coverage</artifactId>
  <packaging>pom</packaging>

  <description>
    JaCoCo coverage aggregator for the deployment-variant integration-test modules
    (insight-brain-variant-test-*). Those modules hold tests that were relocated out of the
    production modules; because JaCoCo reports per-module and the variant modules contain no
    production classes, the coverage they produce is not attributed to production code by the
    normal per-module report. This module runs jacoco:report-aggregate over its reactor
    dependencies (production modules supply class files + their own exec; variant modules supply
    the relocated tests' exec), producing a combined report that Sonar imports via
    sonar.coverage.jacoco.xmlReportPaths. Coverage-only: builds as an empty pom unless a coverage
    profile is active, so normal and one-box/perf builds are unaffected.
  </description>

  <properties>
    <clm.skip>true</clm.skip>
    <!-- Not a shippable artifact; never deploy. -->
    <maven.deploy.skip>true</maven.deploy.skip>
  </properties>

  <dependencies>
    <!-- Production modules: supply compiled classes (attribution targets) and their own test exec. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-common</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-data</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-db</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-policy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-event</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-service</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-tenancy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- nexus-iq-server is intentionally omitted: it is a pom-packaged aggregator with no
         compiled classes to cover, and depending on it as a jar breaks resolution. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>nexus-mtiq-server</artifactId>
      <version>${project.version}</version>
    </dependency>

    <!-- Variant test modules: supply the relocated tests' exec data (no production classes of their own). -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-h2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-pg</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-component-h2</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-component-pg</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-mtiq</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-legacy</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-fips</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>

  <profiles>
    <!-- report-aggregate runs only when a coverage profile is active, matching the rest of the
         reactor. Both ids mirror the root pom's coverage profiles so -P activates them here too. -->
    <profile>
      <id>buildsupport-coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>variant-report-aggregate</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>buildsupport-sonar-coverage</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>variant-report-aggregate</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/site/jacoco-aggregate</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
