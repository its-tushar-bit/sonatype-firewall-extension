@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

/**
 * Standalone pipeline for deploying Docker images to prod-internal cells.
 *
 * Triggered as a downstream job from Jenkinsfile.push-to-prod after successful promotion to prod ECR.
 *
 * Parameters:
 *   IMAGE_TAG - The prod ECR tag to deploy
 *               Format: {dateSection}-{branch}-{buildNumber}-{commitId}
 *
 * Jenkins job path: insight/MTIQ/sca-cloud/deploy-to-prod-internal
 *
 * ============================================================================
 * TEMPORARY BYPASS - PROD INFRASTRUCTURE NOT YET READY
 * ============================================================================
 *
 * The prod AWS infrastructure (ECR, IAM roles, TFC workspaces) is not yet ready.
 * Until it's available, this job runs in bypass mode and returns SUCCESS.
 *
 * Once prod infrastructure is available:
 * 1. Set PROD_INFRASTRUCTURE_READY = true below
 * 2. Update PROD_INTERNAL_CELL_WORKSPACES and PROD_GLOBAL_WORKSPACE below with actual workspace names
 * 3. Remove this comment block
 *
 * Tracked in: CLM-39453
 * ============================================================================
 */

// TODO: Change to true when prod infrastructure is ready
def PROD_INFRASTRUCTURE_READY = false

// Prod-internal cell workspaces — explicit allowlist
// TODO: Replace with actual prod-internal workspace names when infrastructure is ready
def PROD_INTERNAL_CELL_WORKSPACES = ['sca_aws_prod_cell-internal']  // Placeholder
def PROD_GLOBAL_WORKSPACE = 'sca_aws_prod_global'                  // Placeholder

pipeline {
  agent { label 'zion-small' }

  parameters {
    string(name: 'IMAGE_TAG', description: 'The prod ECR tag to deploy (e.g., 202604161432-main-142-a1b2c3d4)')
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '100'))
    timestamps()
    disableConcurrentBuilds()
    // Currently 1 workspace & the new image tag → 20 min is sufficient. Increase if workspaces are added.
    timeout(time: 20, unit: 'MINUTES')
  }

  stages {

    stage('Validate Parameters') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'IMAGE_TAG is required'
          }
          echo "Deploying image tag: ${params.IMAGE_TAG}"
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[url: 'git@github.com:sonatype/insight-brain.git', credentialsId: sonatypeZionCredentialsId()]]
        ])
      }
    }

    stage('Validate Image in Prod ECR') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would validate image ${params.IMAGE_TAG} exists in prod ECR"
            env.RESOLVED_IMAGE_TAG = params.IMAGE_TAG
            return
          }

          def ecr = load 'jenkins/ecr-helpers.groovy'
          ecr.validateImageExists(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            params.IMAGE_TAG
          )
          echo "Validated image exists in prod ECR: ${params.IMAGE_TAG}"
          env.RESOLVED_IMAGE_TAG = params.IMAGE_TAG
        }
      }
    }

    stage('Deploy to Prod-Internal Cells') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would deploy to prod-internal cells with tag: ${env.RESOLVED_IMAGE_TAG}"
            return
          }

          def tfc = load 'jenkins/tfc-helpers.groovy'
          tfc.deployCells('prod-internal', PROD_INTERNAL_CELL_WORKSPACES, PROD_GLOBAL_WORKSPACE, env.RESOLVED_IMAGE_TAG)
        }
      }
    }

    // Tag AFTER successful deployment — Jenkinsfile.deploy-to-prod uses this tag
    // as a safety gate, so it must only exist on images that actually deployed.
    stage('Tag as Verified') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would tag image as verified in prod ECR"
            return
          }

          def ecr = load 'jenkins/ecr-helpers.groovy'
          def dateStamp = new Date().format('yyyyMMdd-HHmm', TimeZone.getTimeZone('UTC'))
          def verifiedTag = "prod-internal-verified-${dateStamp}"

          // Get manifest and apply verified tag
          def manifest = ecr.getImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            params.IMAGE_TAG
          )
          ecr.putImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            verifiedTag,
            manifest
          )
          echo "Tagged image as verified: ${verifiedTag}"
        }
      }
    }
  }

  post {
    success {
      script {
        def status = PROD_INFRASTRUCTURE_READY ? "Deployed" : "Acknowledged (bypass mode)"
        echo "deploy-to-prod-internal: ${status} ${params.IMAGE_TAG}"
      }
    }
    failure {
      script {
        echo "deploy-to-prod-internal: FAILED for ${params.IMAGE_TAG}"
        echo ""
        echo "============================================"
        echo "REMEDIATION"
        echo "============================================"
        echo "If deployment succeeded but tagging failed,"
        echo "manually apply the verified tag in prod ECR:"
        echo ""
        echo "  aws ecr batch-get-image --repository-name <repo> --image-ids imageTag=${params.IMAGE_TAG} --query 'images[0].imageManifest' --output text > manifest.json"
        echo "  aws ecr put-image --repository-name <repo> --image-tag prod-internal-verified-<yyyyMMdd-HHmm> --image-manifest file://manifest.json"
        echo "============================================"
      }
    }
    cleanup {
      sh 'rm -f image-manifest.json || true'
      deleteDir()
    }
  }
}
