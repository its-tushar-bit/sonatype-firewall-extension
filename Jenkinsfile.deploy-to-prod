@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

/**
 * Standalone pipeline for production releases.
 *
 * This is a MANUAL TRIGGER ONLY job - no automated triggers.
 * An operator must explicitly initiate production releases.
 *
 * Parameters:
 *   IMAGE_TAG - The prod ECR tag to release (should be a prod-internal-verified-* tag)
 *   RELEASE_NAME - Optional human-readable release name for tagging
 *
 * Jenkins job path: insight/MTIQ/sca-cloud/deploy-to-prod
 *
 * ============================================================================
 * TEMPORARY BYPASS - PRODUCTION INFRASTRUCTURE NOT YET READY
 * ============================================================================
 *
 * The production AWS infrastructure (ECR, IAM roles, TFC workspaces, control plane)
 * is not yet ready. Until it's available, this job runs in bypass mode and returns SUCCESS.
 *
 * Once production infrastructure is available:
 * 1. Set PROD_INFRASTRUCTURE_READY = true below
 * 2. Update PRODUCTION_CELL_WORKSPACES and PROD_GLOBAL_WORKSPACE below with actual workspace names
 * 3. Remove this comment block
 *
 * Tracked in: CLM-39454
 * ============================================================================
 */

// TODO: Change to true when prod infrastructure is ready
def PROD_INFRASTRUCTURE_READY = false

// Production cell workspaces — explicit allowlist
// TODO: Replace with actual production workspace names when infrastructure is ready
def PRODUCTION_CELL_WORKSPACES = ['sca_aws_prod_cell-1']  // Placeholder
def PROD_GLOBAL_WORKSPACE = 'sca_aws_prod_global'         // Placeholder

pipeline {
  agent { label 'zion-small' }

  // NO triggers block - this job is manual trigger only

  parameters {
    string(name: 'IMAGE_TAG',
           description: 'The prod ECR tag to release (must be a specific immutable tag, e.g., prod-internal-verified-20260421-1432)'),
    string(name: 'RELEASE_NAME',
           defaultValue: '',
           description: 'Optional human-readable release name for tagging (defaults to date-based)')
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '100'))
    disableConcurrentBuilds()
    // NOTE: must exceed 10 min × len(PRODUCTION_CELL_WORKSPACES) + overhead.
    // Currently verify and push tag + 1 workspace → 30 min is sufficient. Increase if workspaces are added.
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {

    stage('Validate Parameters') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'IMAGE_TAG parameter is required'
          }
          echo "Production release for image tag: ${params.IMAGE_TAG}"
          if (params.RELEASE_NAME?.trim()) {
            echo "Release name: ${params.RELEASE_NAME}"
          }
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[url: 'git@github.com:sonatype/insight-brain.git', credentialsId: sonatypeZionCredentialsId()]]
        ])
      }
    }

    stage('Validate Image') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would validate image ${params.IMAGE_TAG} exists in prod ECR"
            echo "BYPASS: Would verify image has prod-internal-verified-* tag"
            return
          }

          def ecr = load 'jenkins/ecr-helpers.groovy'

          // Validate image exists in prod ECR
          ecr.validateImageExists(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            params.IMAGE_TAG
          )

          // Safety check: verify image has a prod-internal-verified tag
          withAwsRole(credentialsId: ecr.PROD_ECR_ACCOUNT.credentialId, role: 'jenkins',
                      roleAccount: ecr.PROD_ECR_ACCOUNT.id, region: ecr.ECR_REGION) {
            withEnv(["REPOSITORY_ARG=${ecr.ECR_REPOSITORY}", "IMAGE_TAG_ARG=${params.IMAGE_TAG}", "REGION_ARG=${ecr.ECR_REGION}"]) {
              def imageDetail = sh(script: '''
                aws ecr describe-images \\
                  --repository-name "$REPOSITORY_ARG" \\
                  --image-ids "imageTag=$IMAGE_TAG_ARG" \\
                  --region "$REGION_ARG" \\
                  --query 'imageDetails[0].imageTags' \\
                  --output json
              ''', returnStdout: true).trim()

              def tags = readJSON text: imageDetail
              if (!tags) {
                error "ECR returned no tags for image ${params.IMAGE_TAG} in ${ecr.ECR_REPOSITORY}. " +
                      "Has the image been promoted from staging?"
              }
              def hasVerifiedTag = tags.any { it.startsWith('prod-internal-verified-') }

              if (!hasVerifiedTag) {
                error "Image ${params.IMAGE_TAG} does not have a prod-internal-verified-* tag. " +
                      "Only images that have passed prod-internal validation can be released to production."
              }
              echo "Verified: Image has prod-internal-verified tag"
            }
          }
        }
      }
    }

    stage('Tag as Production-Ready') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would tag image as production-ready"
            return
          }

          def ecr = load 'jenkins/ecr-helpers.groovy'
          def releaseName = params.RELEASE_NAME?.trim() ?: "production-${new Date().format('yyyyMMdd-HHmm', TimeZone.getTimeZone('UTC'))}"

          // Get manifest from source tag
          def manifest = ecr.getImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            params.IMAGE_TAG
          )

          // Apply production tags
          ecr.putImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            'production-latest',
            manifest
          )

          ecr.putImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            releaseName,
            manifest
          )

          env.RELEASE_NAME = releaseName
          echo "Tagged image with: production-latest, ${releaseName}"
        }
      }
    }

    stage('Deploy to Production') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "============================================"
            echo "PRODUCTION INFRASTRUCTURE NOT YET READY"
            echo "============================================"
            echo "This job is running in BYPASS mode."
            echo "The production AWS infrastructure is being built by another team."
            echo ""
            echo "Once production infrastructure is available:"
            echo "1. Set PROD_INFRASTRUCTURE_READY = true in this Jenkinsfile"
            echo "2. Update PRODUCTION_CELL_WORKSPACES and PROD_GLOBAL_WORKSPACE in this Jenkinsfile"
            echo ""
            echo "Would deploy image tag: ${params.IMAGE_TAG}"
            echo "Release name: ${env.RELEASE_NAME ?: params.RELEASE_NAME ?: 'N/A'}"
            echo "============================================"
            return
          }

          def tfc = load 'jenkins/tfc-helpers.groovy'
          tfc.deployCells('production', PRODUCTION_CELL_WORKSPACES, PROD_GLOBAL_WORKSPACE, params.IMAGE_TAG)
        }
      }
    }
  }

  post {
    success {
      script {
        def releaseInfo = env.RELEASE_NAME ?: params.RELEASE_NAME ?: params.IMAGE_TAG
        def status = PROD_INFRASTRUCTURE_READY ? "Released" : "Acknowledged (bypass mode)"
        echo "deploy-to-prod: ${status} ${releaseInfo}"

        // TODO: Enable when real production is ready
        // notifyChat(currentBuild: currentBuild, env: env, room: 'mtiq-notices',
        //            message: "Production release SUCCESS: ${releaseInfo}")
      }
    }
    failure {
      script {
        echo "deploy-to-prod: FAILED for ${params.IMAGE_TAG}"

        // Provide rollback instructions
        echo "============================================"
        echo "ROLLBACK INSTRUCTIONS"
        echo "============================================"
        echo "1. Identify the previous known-good image tag from prod ECR"
        echo "2. Re-run this job with the previous tag, or"
        echo "3. Manually update the TFC workspace variable and apply"
        echo "============================================"

        // TODO: Enable when real production is ready
        // notifyChat(currentBuild: currentBuild, env: env, room: 'mtiq-notices',
        //            message: "Production release FAILED: ${params.IMAGE_TAG}. Check logs for rollback instructions.")
      }
    }
    cleanup {
      sh 'rm -f image-manifest.json || true'
      deleteDir()
    }
  }
}
