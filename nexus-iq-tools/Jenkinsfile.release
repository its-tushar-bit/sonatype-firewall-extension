@Library(['jenkins-shared', 'iq-pipeline-library']) _

pipeline {
  agent {
    label InsightConstants.AGENT_LABEL
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
    timestamps()
  }

  environment {
    TF_VAR_build_key = "${env.BUILD_TAG}"
    TF_VAR_owner = "release"
    LICENSE_FILE_PATH = credentials('sonatype-internal-nxrm-firewall-lifecycle-1000-users')
  }

  parameters {
    string(name: 'RELEASE_TAG', description: 'The git tag of the release')
    booleanParam(name: 'COMPARE_WITH_PREVIOUS_RELEASE', defaultValue: true,
        description: 'Determines if the current release is compared with a previous release')
    choice(name: 'DATABASE_TYPE', choices: ['H2', 'PostgreSQL'], description: 'Defines the database engine to be used')
  }

  tools {
    jdk 'Java 8'
  }

  stages {

    stage('Build') {
      steps {
        script {
          currentBuild.displayName = "#${BUILD_NUMBER} - ${RELEASE_TAG} - ${DATABASE_TYPE}"
        }

        dir('nexus-iq-tools') {
          withMaven(jdk: 'Java 8', maven: 'M3', mavenSettingsConfig: 'private-settings.xml',
              options: [ artifactsPublisher(disabled: true), junitPublisher(disabled: true) ]) {
            sh 'mvn clean install -Dmaven.repo.local="$WORKSPACE/.zion/repository" -T 1C -DskipTests -Dpmd.skip -Dskip-obfuscate'
          }
        }

        // credentialsId: sonatype-ci/****** (github repo access)
        dir('tag-version-repository') {
          checkout([$class: 'GitSCM', branches: [[name: "refs/tags/$RELEASE_TAG"]],
                    userRemoteConfigs: [[url: 'git@github.com:sonatype/insight-brain.git',
                                         credentialsId: '0f1bae0d-06ce-424f-b80c-3c12d9121e6e']]])

          withMaven(jdk: 'Java 8', maven: 'M3', mavenSettingsConfig: 'private-settings.xml',
              options: [ artifactsPublisher(disabled: true), junitPublisher(disabled: true) ]) {
            sh '''
                mvn clean install -Dmaven.repo.local="$WORKSPACE/.zion/repository" -T 1C -DskipTests -Dpmd.skip -Dskip-obfuscate \
                    -pl -nexus-iq-tools,-insight-brain-frontend,-nexus-iq-cli,-nexus-iq-integrator-scanner,-nexus-iq-server,-insight-rm-common
               '''
          }
        }
      }
    }

    stage ('Create environment for small profile') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh '''
              PROFILE="performance-test-profile-small.json"
              EXTRA_PARAMETERS=""
              if [ "$DATABASE_TYPE" = "PostgreSQL" ]; then
                PROFILE="performance-test-profile-postgres-small.json"
                EXTRA_PARAMETERS="--use-postgres --config-yaml postgres-config-dev.yml"
              fi
              python3 configure_test.py \
                  -p $PROFILE \
                  -iq $WORKSPACE/tag-version-repository/insight-brain-service/target/insight-brain-service-*-server.jar \
                  -tools $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*SNAPSHOT.jar \
                  -auto $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*-automation.zip \
                  -lic $LICENSE_FILE_PATH \
                  -u target_urls.json \
                  -l logback.xml \
                  $EXTRA_PARAMETERS
              ln -s $(ls -t | grep awsPerfRun | head -1) smallAWSPerfRun
             '''
          withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
            sh '''
               terraform init -no-color
               terraform apply -auto-approve -no-color
               '''
          }
        }
      }
      post {
        failure {
          dir('nexus-iq-tools/testsuite') {
            withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
              retry(3) {
                sh 'terraform destroy --force -no-color'
              }
            }
          }
        }
      }
    }

    stage ('Run performance test for small profile') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh './run_aws_test.sh'
        }
      }
      post {
        always {
          dir('nexus-iq-tools/testsuite') {
            withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
              retry(3) {
                sh 'terraform destroy --force -no-color'
              }
            }
          }
        }
      }
    }

    stage ('Create environment for medium profile') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh '''
              PROFILE="performance-test-profile-medium.json"
              EXTRA_PARAMETERS=""
              if [ "$DATABASE_TYPE" = "PostgreSQL" ]; then
                PROFILE="performance-test-profile-postgres-medium.json"
                EXTRA_PARAMETERS="--use-postgres --config-yaml postgres-config-dev.yml"
              fi
              python3 configure_test.py \
                  -p $PROFILE \
                  -iq $WORKSPACE/tag-version-repository/insight-brain-service/target/insight-brain-service-*-server.jar \
                  -tools $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*SNAPSHOT.jar \
                  -auto $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*-automation.zip \
                  -lic $LICENSE_FILE_PATH \
                  -u target_urls.json \
                  -l logback.xml \
                  $EXTRA_PARAMETERS
              ln -s $(ls -t | grep awsPerfRun | head -1) mediumAWSPerfRun
             '''
          withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
            sh '''
               terraform init -no-color
               terraform apply -auto-approve -no-color
               '''
          }
        }
      }
      post {
        failure {
          dir('nexus-iq-tools/testsuite') {
            withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
              retry(3) {
                sh 'terraform destroy --force -no-color'
              }
            }
          }
        }
      }
    }

    stage ('Run performance test for medium profile') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh './run_aws_test.sh'
        }
      }
      post {
        always {
          dir('nexus-iq-tools/testsuite') {
            withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
              retry(3) {
                sh 'terraform destroy --force -no-color'
              }
            }
          }
        }
      }
    }

    stage ('Create environment for large profile') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh '''
              PROFILE="performance-test-profile-large.json"
              EXTRA_PARAMETERS=""
              if [ "$DATABASE_TYPE" = "PostgreSQL" ]; then
                PROFILE="performance-test-profile-postgres-large.json"
                EXTRA_PARAMETERS="--use-postgres --config-yaml postgres-config-dev.yml"
              fi
              python3 configure_test.py \
                  -p $PROFILE \
                  -iq $WORKSPACE/tag-version-repository/insight-brain-service/target/insight-brain-service-*-server.jar \
                  -tools $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*SNAPSHOT.jar \
                  -auto $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*-automation.zip \
                  -lic $LICENSE_FILE_PATH \
                  -u target_urls.json \
                  -l logback.xml \
                  $EXTRA_PARAMETERS
              ln -s $(ls -t | grep awsPerfRun | head -1) largeAWSPerfRun
             '''
          withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
            sh '''
               terraform init -no-color
               terraform apply -auto-approve -no-color
               '''
          }
        }
      }
      post {
        failure {
          dir('nexus-iq-tools/testsuite') {
            withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
              retry(3) {
                sh 'terraform destroy --force -no-color'
              }
            }
          }
        }
      }
    }

    stage ('Run performance test for large profile') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh './run_aws_test.sh'
        }
      }
      post {
        always {
          dir('nexus-iq-tools/testsuite') {
            withDockerContainer(image: 'hashicorp/terraform:0.12.24', args: "--entrypoint=''") {
              retry(3) {
                sh 'terraform destroy --force -no-color'
              }
            }
          }
        }
      }
    }

    stage ('Send reports to S3 bucket') {
      steps {
        dir('nexus-iq-tools/testsuite') {
          sh '''
             aws sts assume-role --role-arn arn:aws:iam::960315589060:role/ZionJenkins \
                 --role-session-name perf_session --external-id perf_id > temp_role.json
             set +x # do not print credentials on screen
             export AWS_ACCESS_KEY_ID=`jq -r .Credentials.AccessKeyId temp_role.json`
             export AWS_SECRET_ACCESS_KEY=`jq -r .Credentials.SecretAccessKey temp_role.json`
             export AWS_SESSION_TOKEN=`jq -r .Credentials.SessionToken temp_role.json`
             set -x

             aws s3 cp smallAWSPerfRun/perf_results* \
                "s3://iq-perf-results/releases/$RELEASE_TAG/$DATABASE_TYPE/$RELEASE_TAG-$DATABASE_TYPE-small.out"
             aws s3 cp smallAWSPerfRun/results.tar.xz \
                "s3://iq-perf-results/releases/$RELEASE_TAG/$DATABASE_TYPE/$RELEASE_TAG-$DATABASE_TYPE-small-results.tar.xz"

             aws s3 cp mediumAWSPerfRun/perf_results* \
                "s3://iq-perf-results/releases/$RELEASE_TAG/$DATABASE_TYPE/$RELEASE_TAG-$DATABASE_TYPE-medium.out"
             aws s3 cp mediumAWSPerfRun/results.tar.xz \
                "s3://iq-perf-results/releases/$RELEASE_TAG/$DATABASE_TYPE/$RELEASE_TAG-$DATABASE_TYPE-medium-results.tar.xz"

             aws s3 cp largeAWSPerfRun/perf_results* \
                "s3://iq-perf-results/releases/$RELEASE_TAG/$DATABASE_TYPE/$RELEASE_TAG-$DATABASE_TYPE-large.out"
             aws s3 cp largeAWSPerfRun/results.tar.xz \
                "s3://iq-perf-results/releases/$RELEASE_TAG/$DATABASE_TYPE/$RELEASE_TAG-$DATABASE_TYPE-large-results.tar.xz"

             rm temp_role.json
             unset AWS_ACCESS_KEY_ID AWS_SECRET_ACCESS_KEY AWS_SESSION_TOKEN
             '''
        }
      }
    }

    stage ('Compare with previous release') {
      when {
        expression { params.COMPARE_WITH_PREVIOUS_RELEASE == true }
      }
      steps {
        dir('nexus-iq-tools/testsuite') {
          // TODO: the S3 sorted order can break in the future when it reaches more digits
          sh '''
              aws sts assume-role --role-arn arn:aws:iam::960315589060:role/ZionJenkins \
                  --role-session-name perf_session --external-id perf_id > temp_role.json
              set +x # do not print credentials on screen
              export AWS_ACCESS_KEY_ID=`jq -r .Credentials.AccessKeyId temp_role.json`
              export AWS_SECRET_ACCESS_KEY=`jq -r .Credentials.SecretAccessKey temp_role.json`
              export AWS_SESSION_TOKEN=`jq -r .Credentials.SessionToken temp_role.json`
              ALL_RELEASE_TAGS=$(aws s3 ls s3://iq-perf-results/releases/ | grep release | sed 's/.*\\(release.*\\)\\//\\1/')
              for line in $ALL_RELEASE_TAGS; do
                if [ "$line" = "$RELEASE_TAG" ]; then
                  break
                else
                  PREVIOUS_RELEASE_TAG="$line"
                fi
              done
              set -x
              aws s3 cp "s3://iq-perf-results/releases/$PREVIOUS_RELEASE_TAG/$DATABASE_TYPE/$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-small.out" \
                  "$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-small.out"
              aws s3 cp "s3://iq-perf-results/releases/$PREVIOUS_RELEASE_TAG/$DATABASE_TYPE/$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-medium.out" \
                  "$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-medium.out"
              aws s3 cp "s3://iq-perf-results/releases/$PREVIOUS_RELEASE_TAG/$DATABASE_TYPE/$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-large.out" \
                  "$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-large.out"

              cp smallAWSPerfRun/perf_results* "zzz-$RELEASE_TAG-small.out"
              java -jar -Dlogback.configurationFile="$(pwd)/logback.xml" \
                  $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*SNAPSHOT.jar \
                  resultdiff "$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-small.out" "zzz-$RELEASE_TAG-small.out" | tee resultdiff-small.out
              python3 resultdiff_validator.py -f resultdiff-small.out

              cp mediumAWSPerfRun/perf_results* "zzz-$RELEASE_TAG-medium.out"
              java -jar -Dlogback.configurationFile="$(pwd)/logback.xml" \
                  $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*SNAPSHOT.jar \
                  resultdiff "$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-medium.out" "zzz-$RELEASE_TAG-medium.out" | tee resultdiff-medium.out
              python3 resultdiff_validator.py -f resultdiff-medium.out

              cp largeAWSPerfRun/perf_results* "zzz-$RELEASE_TAG-large.out"
              java -jar -Dlogback.configurationFile="$(pwd)/logback.xml" \
                  $WORKSPACE/nexus-iq-tools/target/nexus-iq-tools-*SNAPSHOT.jar \
                  resultdiff "$PREVIOUS_RELEASE_TAG-$DATABASE_TYPE-large.out" "zzz-$RELEASE_TAG-large.out" | tee resultdiff-large.out
              python3 resultdiff_validator.py -f resultdiff-large.out
             '''
        }
      }
      post {
        always {
          dir('nexus-iq-tools/testsuite') {
            archiveArtifacts artifacts: 'resultdiff-*.out', fingerprint: true
          }
        }
      }
    }
  }

  post {
    failure {
      sh 'echo dummy-step'
      // TODO: enable this once this pipeline is finished
      /*notifyChat(currentBuild: currentBuild, env: env, room: 'skyfall')
      script {
        def recipientProviders = [[$class: 'RequesterRecipientProvider']]
        sendEmailNotification(currentBuild, env, recipientProviders, 'sbaker@sonatype.com, amunoz@sonatype.com')
      }*/
    }
    cleanup {
      deleteDir()
    }
  }

}
