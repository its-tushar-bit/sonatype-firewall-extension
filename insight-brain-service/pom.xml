              <goal>test</goal>
            </goals>
            <configuration>
              <preloadSources>
                <source>root/target/classes/assets/version-graph/version.graph.app.js</source>
                <source>node_modules/es6-collections/es6-collections.js</source>
                <source>${basedir}/node_modules/angular-mocks/angular-mocks.js</source>
