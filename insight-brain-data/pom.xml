  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <reuseForks>true</reuseForks>
          <!-- 0.25C means 0.25 x number-of-CPUs:
                8 CPUs -> 2 forks
               16 CPUs -> 4 forks
           -->
          <forkCount>0.25C</forkCount>
        </configuration>
        <executions>
          <!-- Override default to exclude Postgres tests (run H2/unit tests first) -->
          <execution>
            <id>default-test</id>
            <configuration>
              <excludedGroups>PostgresTestCategory,SlowTest</excludedGroups>
            </configuration>
          </execution>
          <!-- Run Postgres tests together to avoid fixture thrashing -->
          <execution>
            <id>postgres-tests</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <groups>PostgresTestCategory</groups>
              <excludedGroups>SlowTest</excludedGroups>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <!-- PMD: enforce fetchStream() resource-safety -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-pmd-plugin</artifactId>
        <version>3.26.0</version>
        <configuration>
          <rulesets>
            <ruleset>${project.basedir}/src/main/pmd/fetchstream-resource-ruleset.xml</ruleset>
          </rulesets>
          <printFailingErrors>true</printFailingErrors>
          <failOnViolation>true</failOnViolation>
          <includeTests>false</includeTests>
          <targetJdk>23</targetJdk>
          <typeResolution>false</typeResolution>
        </configuration>
        <executions>
          <execution>
            <id>pmd-check</id>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/JPA*</include>
                <include>**/DatamartUpdaterState*</include>
                <include>**/TemporaryEntity*</include>
                <include>**/TemporaryEntity/**</include>
                <include>**/PolicyWaiverBuilder*</include>
                <include>**/PolicyWaiverRequestBuilder*</include>
                <include>**/PolicyViolationAggregationDataHelper*</include>
                <include>**/LicenseThreatGroupDataHelper*</include>
                <include>**/TestLicenseThreatGroups.json</include>
                <include>**/DisplayFieldValueAssertionUtil*</include>
                <include>**/TestPolicyWaiverBuilder*</include>
                <include>**/AbstractDataTest*</include>
                <include>**/TestDAOFactory*</include>
                <include>**/ConditionTypesTestHelper*</include>
                <include>**/ThirdPartySbomMetadataTestUtil*</include>
                <include>**/SbomMetadataBuilder*</include>
                <include>**/ScmUserMappingsHelper*</include>
                <include>**/TemporaryTableHelperTest*</include>
                <include>**/TestSamlFactory*</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
