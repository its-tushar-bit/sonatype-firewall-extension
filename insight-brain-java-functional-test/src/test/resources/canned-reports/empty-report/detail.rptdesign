            <property name="dataSource">bom</property>
            <method name="open"><![CDATA[index = 0;
now = new Date().getTime();

getAge = function(timestamp) {
	var val,
		unit,
		diff = now - timestamp;
	if ( diff > 12 * 30 * 24 * 60 * 60 * 1000) {
		val = diff / (12 * 30 * 24 * 60 * 60 * 1000);
		unit = 'year';
	} else if (diff > 30 * 24 * 60 * 60 * 1000) {
		val = diff / (30 * 24 * 60 * 60 * 1000);
		unit = 'month';
	} else if (diff > 24 * 60 * 60 * 1000) {
		val = diff / (24 * 60 * 60 * 1000);
		unit = 'day';
	} else if (diff > 60 * 60 * 1000) {
		val = diff / (60 * 60 * 1000);
		unit = 'hour';
	} else if (diff > 60 * 1000) {
		val = diff / (60 * 1000);
		unit = 'minute';
	} else {
		return 'moments ago';
	}
	val = Math.floor(val);
	if (val > 1) {
		unit += 's';
	}
	return val + ' ' + unit;
};
]]></method>
            <method name="fetch"><![CDATA[if (index >= bom.length) {
	return false;
}

var comp = bom[index];

row["format"] = getFormat(comp);
row["displayName"] = getDisplayName(comp);

if (comp.matchState === 'unknown') {
	if (comp.scanError) {
		row["state"] = 'error';
	} else if (comp.proprietary) {
		row["state"] = 'proprietary';
	} else {
		row["state"] = comp.matchState;
	}
} else {
	row["state"] = comp.matchState;
	if (comp.proprietary) {
		row["state"] += ' (proprietary)';
	}
}

row["age"] = comp.createTime ? getAge(comp.createTime) : "NA";

row["declaredLicenses"] = comp.declaredLicenses || [];
row["observedLicenses"] = comp.observedLicenses || [];

var threat = comp.effectiveLicenseThreat;
row["effectiveLicenseThreat"] = threat;
if (threat > 7) {
	row["color"] = "red";
} else if (threat > 3) {
	row["color"] = "orange";
} else if (threat > 0) {
	row["color"] = "yellow";
} else if (threat == 0) {
	row["color"] = "blue";
} else {
	row["color"] = "grey";
}

row["svLevel"] = Math.floor(comp.svLevel);
row["svCount"] = comp.svCount;
row["policyViolationCounts"] = comp.policyViolationCounts;
row["website"] = comp.website;
index++;

return true;
]]></method>
