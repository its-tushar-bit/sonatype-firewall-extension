  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated</directory>
      </resource>
      <resource>
        <directory>src/main/filtered-resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/policy/js/</targetPath>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/assets/js/</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.sonatype.plugins</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <!-- Use 1.1 because: https://github.com/sonatype/insight-brain/commit/63133339 -->
        <version>1.1</version>
        <executions>
          <execution>
            <id>index-service</id>
            <phase>process-classes</phase>
            <goals>
              <goal>index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-XX:MaxPermSize=144m</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.klieber</groupId>
        <artifactId>phantomjs-maven-plugin</artifactId>
        <version>${phantomjs-maven-plugin.version}</version>
        <executions>
          <execution>
            <goals>
              <goal>install</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <version>1.9.2</version>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.searls</groupId>
        <artifactId>jasmine-maven-plugin</artifactId>
        <version>${jasmine.version}</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <id>${jasmine.cip.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <preloadSources>
                <source>cip/cip-test-util.js</source>
              </preloadSources>
              <sourceIncludes>
                <include>resources/assets/assets/lib/jquery/jquery-*.min.js</include>
                <include>resources/assets/assets/lib/bootstrap/bootstrap-*.min.js</include>
                <include>resources/assets/assets/lib/angular/angular-${angularjs.version}.js</include>
                <include>resources/assets/assets/js/Hudson.js</include>
                <include>resources/assets/cip/*.js</include>
                <include>resources/assets/assets/util/AngularCommon.js</include>
              </sourceIncludes>
              <specIncludes>
                <include>resources/assets/SpecUtil.js</include>
                <include>resources/assets/**/lib/*.js</include>
                <include>resources/assets/**/*MockData.js</include>
                <include>resources/assets/**/cip*.js</include>
                <include>resources/assets/**/CIP*.js</include>
              </specIncludes>
              <junitXmlReportFileName>TEST-cip.xml</junitXmlReportFileName>
            </configuration>
          </execution>
          <execution>
            <id>${jasmine.login.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <sourceIncludes>
                <include>resources/assets/assets/lib/jquery/jquery-*.min.js</include>
                <include>resources/assets/assets/lib/bootstrap/bootstrap-*.min.js</include>
                <include>resources/assets/assets/lib/angular/angular-${angularjs.version}.js</include>
                <include>resources/assets/assets/lib/Base64.js</include>
                <include>resources/assets/assets/lib/d3/d3.min.js</include>
                <include>resources/assets/login/*.js</include>
                <include>resources/assets/assets/util/AngularCommon.js</include>
                <include>resources/assets/assets/util/CLMLocation.js</include>
                <include>resources/assets/assets/js/Hudson.js</include>
              </sourceIncludes>
              <specIncludes>
                <include>resources/assets/SpecUtil.js</include>
                <include>resources/assets/**/lib/*.js</include>
                <include>resources/assets/**/*MockData.js</include>
                <include>resources/assets/**/login/*-spec.js</include>
              </specIncludes>
              <junitXmlReportFileName>TEST-login.xml</junitXmlReportFileName>
            </configuration>
          </execution>
          <execution>
            <id>${jasmine.brain.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <sourceIncludes>
                <include>resources/assets/assets/lib/jquery/jquery-*.min.js</include>
                <include>resources/assets/assets/lib/bootstrap/bootstrap-*.min.js</include>
                <include>resources/assets/assets/lib/angular/angular-${angularjs.version}.js</include>
                <include>resources/assets/assets/lib/angular-ui-router-0.0.1.min.js</include>
                <include>resources/assets/assets/lib/ui-bootstrap-tpls-0.3.0.min.js</include>
                <include>resources/assets/assets/lib/X-editable/bootstrap-editable.min.js</include>
                <include>resources/assets/assets/**/*.js</include>
                <include>resources/assets/application/**/*.js</include>
                <include>resources/assets/policy/**/*.js</include>
                <include>resources/assets/organization/**/*.js</include>
                <include>resources/assets/configuration/**/*.js</include>
                <include>resources/assets/security/**/*.js</include>
                <include>resources/assets/report/**/*.js</include>
                <include>wro4j/**/*.js</include>
              </sourceIncludes>
              <specIncludes>
                <include>resources/assets/SpecUtil.js</include>
                <include>resources/assets/**/lib/*.js</include>
                <include>resources/assets/**/*MockData.js</include>
                <include>resources/assets/**/*-spec.js</include>
                <include>resources/assets/**/*Spec.js</include>
              </specIncludes>
              <specExcludes>
                <exclude>resources/assets/**/cip*.js</exclude>
                <exclude>resources/assets/**/CIP*.js</exclude>
                <exclude>resources/assets/**/login/*</exclude>
              </specExcludes>
              <junitXmlReportFileName>TEST-server.xml</junitXmlReportFileName>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <jasmineTargetDir>${project.build.directory}${file.separator}jasmine-reports</jasmineTargetDir>
          <jsSrcDir>${project.basedir}/src/main</jsSrcDir>
          <jsTestSrcDir>${project.basedir}/src/test</jsTestSrcDir>
          <keepServerAlive>true</keepServerAlive>
          <webDriverClassName>org.openqa.selenium.phantomjs.PhantomJSDriver</webDriverClassName>
          <webDriverCapabilities>
            <phantomjs.binary.path>${phantomjs.binary}</phantomjs.binary.path>
          </webDriverCapabilities>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.timurstrekalov</groupId>
        <artifactId>saga-maven-plugin</artifactId>
        <version>${saga.version}</version>
        <executions>
          <execution>
            <id>jasmine-coverage</id>
            <phase>test</phase>
            <goals>
              <goal>coverage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <baseDir>http://localhost:${jasmine.serverPort}</baseDir>
          <backgroundJavaScriptTimeout>1000</backgroundJavaScriptTimeout>
          <outputDir>${project.build.directory}/coverage</outputDir>
          <sortBy>file</sortBy>
          <noInstrumentPatterns>
            <pattern>.*/SpecUtil\.js</pattern>
            <pattern>.*/lib/.*\.js</pattern>
            <pattern>.*/.*MockData\.js</pattern>
            <pattern>.*/.*-spec\.js</pattern>
            <pattern>.*/.*Spec\.js</pattern>
          </noInstrumentPatterns>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>server</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:sisu-inject-bean</artifact>
                  <excludes>
                    <!-- avoid conflict with same resource from BIRT -->
                    <exclude>plugin.xml</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:org.eclipse.birt.runtime</artifact>
                  <includes>
                    <include>*.xml</include>
                    <include>org/eclipse/**</include>
                    <include>javax/**</include>
                  </includes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sonatype.insight.brain.service.InsightBrainService</mainClass>
                  <manifestEntries>
                    <!-- Required by BIRT to discover the extensions we have shaded in -->
                    <Bundle-SymbolicName>${project.groupId}.server</Bundle-SymbolicName>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>ro.isdc.wro4j</groupId>
        <artifactId>wro4j-maven-plugin</artifactId>
        <version>${wro4j.version}</version>
        <executions>
          <execution>
            <id>assets</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>jshint</goal>
              <goal>run</goal>
            </goals>
            <configuration>
              <minimize>false</minimize>
              <options>camelcase,curly,indent=2,eqeqeq,forin,immed,noarg,quotmark='single',undef,unused,strict,trailing,browser,jquery</options>
              <targetGroups>clm-server</targetGroups>
              <cssDestinationFolder>${project.build.directory}/generated/assets/assets/css/</cssDestinationFolder>
              <jsDestinationFolder>${project.build.directory}/generated/assets/assets/js/</jsDestinationFolder>
            </configuration>
          </execution>
          <execution>
            <id>css-cip</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <targetGroups>cip</targetGroups>
              <cssDestinationFolder>${project.build.directory}/generated/assets/cip/</cssDestinationFolder>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <wroFile>${basedir}/wro.xml</wroFile>
          <extraConfigFile>${basedir}/wro.properties</extraConfigFile>
          <wroManagerFactory>ro.isdc.wro.maven.plugin.manager.factory.ConfigurableWroManagerFactory</wroManagerFactory>
          <ignoreMissingResources>false</ignoreMissingResources>
          <contextFolder>${basedir}/src/main/wro4j/</contextFolder>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/AbstractBrainServiceTest*</include>
                <include>**/TestInsightBrainService*</include>
                <include>**/AbstractLicenseTest*</include>
                <include>**/AbstractResourceTest*</include>
                <include>**/TestLicenseFingerprinter*</include>
                <include>**/TestProductLicenseManager*</include>
                <include>**/AuthedRestAccess*</include>
                <include>**/productlicense/license.lic</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.searls</groupId>
                    <artifactId>jasmine-maven-plugin</artifactId>
                    <versionRange>[1.2.0.0,)</versionRange>
                    <goals>
                      <goal>test</goal>
                      <goal>testResources</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.sonatype.plugins</groupId>
                    <artifactId>sisu-maven-plugin</artifactId>
                    <versionRange>[1.0,)</versionRange>
                    <goals>
                      <goal>index</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.klieber</groupId>
                    <artifactId>phantomjs-maven-plugin</artifactId>
                    <versionRange>[0.1,)</versionRange>
                    <goals>
                      <goal>install</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      To execute just the Jasmine tests run mvn jasmine:test -P <test profile>
      E.g. mvn jasmine:test -P test-brain
    -->
    <profile>
      <id>test-cip</id>
      <properties>
        <jasmine.cip.id>default-cli</jasmine.cip.id>
      </properties>
    </profile>
    <profile>
      <id>test-brain</id>
      <properties>
        <jasmine.brain.id>default-cli</jasmine.brain.id>
      </properties>
    </profile>
    <profile>
      <id>test-login</id>
      <properties>
        <jasmine.login.id>default-cli</jasmine.login.id>
      </properties>
    </profile>
  </profiles>
</project>
