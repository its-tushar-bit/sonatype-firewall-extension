@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Announce Release Starting') {
      steps {
        slackSend color: 'good', channel: '#iq-releases',
            message: "Starting IQ Server release ${params.releaseVersion}. See ${params.releaseJira}"
      }
    }

    stage('Broadcast To Marketing') {
      steps {
        slackSend color: 'good', channel: '#iq',
            message: "@product-marketing-team IQ Server release ${params.releaseVersion} has started. Review ${params.productNotificationJira} for In Product Notification."
      }
    }
  }
}
