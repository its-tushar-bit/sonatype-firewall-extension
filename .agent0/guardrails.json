{
  "version": 1,
  "format": [
    {
      "command": "mvn -Dmaven.repo.local=./.build/m2 checkstyle:check pmd:check license:check"
    },
    {
      "command": "cd insight-brain-frontend && yarn format --check"
    },
    {
      "command": "cd insight-brain-frontend && yarn test-lint"
    }
  ],
  "build": [
    {
      "command": "mvn -Dmaven.repo.local=./.build/m2 clean install -Pquick"
    }
  ],
  "tests": [
    {
      "command": "mvn -Dmaven.repo.local=./.build/m2 verify -DexcludedGroups=SlowTest -Dskip-functional-test"
    },
    {
      "command": "cd insight-brain-frontend && yarn test"
    }
  ]
}
