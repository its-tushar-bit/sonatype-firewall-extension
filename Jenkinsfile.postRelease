@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties([
    parameters([
      string(name: 'releaseVersion', defaultValue: '',description: 'The version number for the product, like "1.118.0-01"'),
    ])
])

pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  environment {
    shortVersion = "${params.releaseVersion.split('-')[0]}"
  }
  stages {
    stage('Update IQ Server Test Instance') {
      steps {
        build(
            job: 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/staging',
            parameters: [
                string(name: 'BASE_IMAGE', value: "${sonatypeDockerRegistryId()}/sonatype/nexus-iq-server:${env.shortVersion}"),
                string(name: 'TARGET_IMAGE', value: "${sonatypeDockerRegistryId()}/iq/staging:${params.releaseVersion}")
            ]
        )

        build(
            job: 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/staging',
            parameters: [
                string(name: 'environment', value: 'Staging'),
                string(name:'imageUrl', value: "${sonatypeDockerRegistryId()}/iq/staging:${params.releaseVersion}")
            ]
        )
      }
    }
    stage('Update IQ Server Production Instance') {
      steps {
        build(
            job: 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/production',
            parameters: [
                string(name: 'BASE_IMAGE', value: "${sonatypeDockerRegistryId()}/sonatype/nexus-iq-server:${env.shortVersion}"),
                string(name: 'TARGET_IMAGE', value: "${sonatypeDockerRegistryId()}/iq/prod:${params.releaseVersion}")
            ]
        )

        build(
            job: 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/production',
            parameters: [
                string(name: 'environment', value: 'Production'),
                string(name:'imageUrl', value: "${sonatypeDockerRegistryId()}/iq/prod:${params.releaseVersion}")
            ]
        )
      }
    }
    stage('Prepare IQ Server HA Helm Chart') {
      steps {
        build(
          job: 'insight/insight-brain/HA/Main Release Build',
          parameters: [
            string(name: 'appVersion', value: env.shortVersion)
          ]
        )
      }
    }
    stage('Publish IQ Server Helm Chart') {
      steps {
        build(
          job: 'integrations/cloud/Helm3 Charts/Main Release Build',
          parameters: [
              string(name: 'chart', value: 'nexus-iq-server'),
              string(name: 'appVersion', value: env.shortVersion)
          ]
        )
      }
    }
    stage('Create Post IQ Release Jira Issues') {
      steps {
        build(
            job: 'insight/insight-brain/createJiraIssues',
            parameters: [string(name: 'version', value: params.releaseVersion)])
      }
    }
  }
  post {
    failure {
      notifyChat(currentBuild: currentBuild, env: env, room: 'iq-builds')
    }
  }
}
