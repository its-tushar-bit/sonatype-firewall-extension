<?xml version="1.0" encoding="UTF-8"?>
<report xmlns="http://www.eclipse.org/birt/2005/design" version="3.2.23" id="1">
    <property name="createdBy">Eclipse BIRT Designer Version 4.4.0.v201405191524 Build &lt;4.4.0.v20140606-1451></property>
    <property name="units">in</property>
    <method name="initialize"><![CDATA[
//support for zebra-striping across multiple nested tables
reportContext.setPersistentGlobalVariable("lastComponentPolicyViolationRow", "0");

function getLegacyDisplayName(component) {
  if(component.groupId) {
    return component.groupId + ' : ' + component.artifactId + ' : ' + component.version;
  }

  if (component.filenames &amp;&amp; component.filenames.length) {
    return component.filenames.join(", ");
  }

  return "Unnamed SHA1: " + component.hash;
}

function getDisplayName(component, legacyDisplayNameFunction) {
  if(component.displayName &amp;&amp; component.displayName.parts) {
    return component.displayName.parts.map(function(e) {
      return e.value;
    }).join("");
  }

  if(legacyDisplayNameFunction) {
    return legacyDisplayNameFunction(component);
  }
  
  return getLegacyDisplayName(component); 
}

function getFormat(component) {
  if(component.componentIdentifier &amp;&amp; component.componentIdentifier.format) {
    return component.componentIdentifier.format;
  }
  
  return component.groupId ? 'maven' : 'unknown';
}

function getComponentKey(component) {
  return getFormat(component)+"_"+getDisplayName(component);
}]]></method>
    <property name="layoutPreference">fixed layout</property>
    <property name="bidiLayoutOrientation">ltr</property>
    <property name="imageDPI">120</property>
    <parameters>
        <scalar-parameter name="reportDir" id="15">
            <text-property name="promptText">Report Directory</text-property>
