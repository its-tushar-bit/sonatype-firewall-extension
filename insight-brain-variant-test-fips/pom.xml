<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonatype.insight.brain</groupId>
    <artifactId>insight-brain</artifactId>
    <version>1.207.0-SNAPSHOT</version>
    <!-- Required when this folder is opened alone so Maven / Java LS resolve the reactor and dependencyManagement. -->
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>insight-brain-variant-test-fips</artifactId>

  <description>
    FIPS-mode integration tests: the single-tenant IQ *FIPSTest classes moved out of
    insight-brain-service. Each test class inserts a BouncyCastle FIPS security provider
    (FipsTestUtil.insertBouncyCastleFipsProvider) and sets FIPS_MODE_ENABLED before running its
    inherited (non-FIPS) scenarios. Because a FIPS provider is a JVM-global mutation of
    java.security.Security, these tests CANNOT share a reused, single-JVM context — they would poison
    every other test in that JVM. So they live here with reuseForks=false, giving each FIPS test class
    its own JVM (and therefore its own clean security-provider state). The non-FIPS base classes stay
    in insight-brain-service and arrive on the classpath via its test-jar purely as superclasses; the
    failsafe include is narrowed to **/*FIPSTest.* so only the FIPS subclasses run and the bases never
    execute standalone. Run:
    mvn verify -pl insight-brain-variant-test-fips -Dskip-functional-test
  </description>

  <properties>
    <clm.skip>true</clm.skip>
  </properties>

  <build>
    <plugins>
      <!-- Tests run under Failsafe (integration-test/verify), mirroring the other variant modules. -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <includes>
            <!-- Only the FIPS subclasses run. Every moved class ends in FIPSTest, so this matches
                 exactly the 20 FIPS tests and never the non-FIPS base classes that arrive on the
                 classpath via the insight-brain-service / nexus-mtiq-server test-jars purely as
                 superclasses. This drops the fragile hand-maintained base-exclude list and is
                 future-proof: a new non-FIPS base named *Test on the classpath can never match. -->
            <include>**/*FIPSTest.*</include>
          </includes>
          <trimStackTrace>false</trimStackTrace>
          <!--
            reuseForks=false: each FIPS test class runs in its own JVM so the BouncyCastle FIPS
            provider it installs (a JVM-global java.security.Security mutation) cannot leak into any
            other test. This is the whole reason these tests are split out of insight-brain-service.
          -->
          <reuseForks>false</reuseForks>
          <forkCount>1</forkCount>
          <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
          <shutdown>kill</shutdown>
          <!--
            Inline add-opens (Spring Boot 4 on JDK 25 needs these) plus a byte-buddy agent for Mockito.
            @{jacocoVariantArgLine} carries the JaCoCo agent under the coverage profiles
            (buildsupport-coverage / -sonar-coverage); it is empty otherwise, so normal and
            one-box/perf runs keep this exact, tuned argLine.
          -->
          <argLine>
            @{jacocoVariantArgLine}
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.security=ALL-UNNAMED
            --add-opens=java.base/sun.security.rsa=ALL-UNNAMED
            --add-opens=java.base/sun.security.x509=ALL-UNNAMED
            --add-opens=java.base/sun.security.util=ALL-UNNAMED
            --add-opens=java.xml/com.sun.org.apache.xerces.internal.jaxp.datatype=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            -Xmx3072M
            -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar
            -XX:+HeapDumpOnOutOfMemoryError
            -XX:HeapDumpPath=${project.build.directory}/
          </argLine>
          <systemPropertyVariables>
            <!-- Used by the test Spring config to set a per-fork work directory. -->
            <test.forkId>#${surefire.forkNumber}</test.forkId>
          </systemPropertyVariables>
          <!--
            Drools/kie must stay on the classpath here: the component tests exercise real policy
            evaluation via the plain insight-brain-service Spring context.
          -->
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- No artifacts to deploy: this module only runs tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- JUnit 5 (Jupiter) engine on the JUnit Platform. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.junit.vintage</groupId>
          <artifactId>junit-vintage-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <!-- @ParameterizedTest/@MethodSource support for converted tests that use it. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- JUnit 4 System Rules: EnvironmentVariables rule used by the FIPS tests to toggle FIPS_MODE_ENABLED. -->
    <dependency>
      <groupId>com.github.stefanbirkner</groupId>
      <artifactId>system-rules</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Shared variant-test machinery (ComponentTestDbHarnessExtension, @ComponentH2Test) — not used by
         the JUnit 4 FIPS tests directly (they extend their non-FIPS bases from the insight-brain-service
         test-jar), but retained defensively in case a base references it. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- IQ app under test + its test fixtures (AbstractComponentTest, AbstractServiceAuthzTest,
         SpringTestConfiguration, DatabaseContainerRule, SearchIndexRule, factories, ...). Also brings the
         bc-fips / bcpkix-fips / bctls-fips providers transitively. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-service</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-service</artifactId>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>

    <!-- DB/data/common test fixtures (DatabaseRuleAnnotations, H2 fixtures, TemporaryEntity, ...).
         insight-brain-common test-jar also carries FipsTestUtil and TestFipsEncryptionKeyStore. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-db</artifactId>
      <type>test-jar</type>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-data</artifactId>
      <type>test-jar</type>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-common</artifactId>
      <type>test-jar</type>
    </dependency>

    <!-- SpringTestExecutionContext lives here. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-test</artifactId>
    </dependency>

    <!-- Tenant helpers: CLMLicenseManagerTest references com.sonatype.insight.brain.tenancy.TenantTestHelper
         (testAsTenant/testAsNewTenant) at runtime even in the single-tenant flow. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-tenancy</artifactId>
      <classifier>tests</classifier>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- HDS mock the component beans may wire up. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>hds-mock-server</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- WireMock, used by CrowdMockServerRule and similar @Rule-based mock servers. -->
    <dependency>
      <groupId>com.github.tomakehurst</groupId>
      <artifactId>wiremock-jre8-standalone</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Embedded LDAP (ApacheDS) for the LDAP-backed security tests (User*/UserToken*/PolicyAlertEmailer/UserDirectory). -->
    <dependency>
      <groupId>org.apache.directory.server</groupId>
      <artifactId>apacheds-core-integ</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Byte Buddy agent for Mockito (referenced by the failsafe -javaagent). -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Legacy javax.xml.bind (JAXB 2.x) runtime impl. Mirrors insight-brain-service's runtime dep so
      any javax-namespace JAXBContext.newInstance in the component context resolves a provider.
    -->
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <version>2.3.9</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
