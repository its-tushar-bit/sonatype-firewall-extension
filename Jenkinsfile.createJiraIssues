@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties([
    parameters([
      string(name: 'version', defaultValue: '',description: 'The version number for the product, like "1.118.0-01"'),
    ])
])

pipeline {
  agent { label 'zion-small' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Create JIRA Issues') {
      steps {
        createJiraIssuesAfterIQRelease(params.version)
      }
    }
  }
}
