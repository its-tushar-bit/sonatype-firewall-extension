  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-maven-plugin</artifactId>
            <version>${spring-boot.version}</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <!-- Skipped for non-bundling feature builds (-Dmtiq.package.skip=true): the shaded
                   uber jar is not consumed by the test pipeline, only by the MTIQ image/release. -->
              <skip>${mtiq.package.skip}</skip>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <finalName>nexus-mtiq-server</finalName> <!-- Note: version number is not included in the filename -->
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>mtiq</shadedClassifierName>
              <artifactSet>
                <includes>
                  <include>com.sonatype.insight.brain:insight-brain-service</include>
                  <include>io.dropwizard:dropwizard-json-logging</include>
                  <include>io.opentelemetry:*</include>
                  <include>io.opentelemetry.instrumentation:*</include>
                  <include>io.opentelemetry.proto:*</include>
                  <include>com.google.protobuf:protobuf-java</include>
                  <include>io.micrometer:micrometer-registry-otlp</include>
                  <include>software.amazon.awssdk:*</include>
                  <include>org.reactivestreams:reactive-streams</include>
                </includes>
<!--                <excludes>-->
<!--                  <exclude>insight-jaxrs-testing:*</exclude>-->
<!--                </excludes>-->
              </artifactSet>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sonatype.insight.brain.service.MultiTenantInsightBrainService</mainClass>
                  <manifestEntries>
                    <!--
                     Required so the JVM honors META-INF/versions/<N>/ at class-load time.
                     Lucene (and other modern libs) ship their JDK 19+/21+ mmap implementations
                     there; without this flag the JVM treats the uber jar as non-MR and throws
                     ClassNotFoundException for e.g. MemorySegmentIndexInputProvider on JDK 25.
                     shade strips the input jars' manifests, so we must re-assert it. (CLM-39482)
                     -->
                    <Multi-Release>true</Multi-Release>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/spring/org.springframework.boot.autoconfigure.AutoConfiguration.imports</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/spring/org.springframework.boot.actuate.autoconfigure.web.ManagementContextConfiguration.imports</resource>
                </transformer>
                <transformer implementation="org.springframework.boot.maven.PropertiesMergingResourceTransformer">
                  <resource>META-INF/spring.factories</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/spring-autoconfigure-metadata.properties</resource>
                </transformer>
                <transformer implementation="org.springframework.boot.maven.PropertiesMergingResourceTransformer">
                  <resource>META-INF/spring/aot.factories</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/spring.handlers</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/spring.schemas</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <includes>
            <include>**/*Test.*</include>
          </includes>
          <trimStackTrace>false</trimStackTrace>
          <reuseForks>true</reuseForks>
          <useUnlimitedThreads>false</useUnlimitedThreads>
          <!-- 15 minute timeout per fork to prevent hanging builds -->
          <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
          <!-- Shutdown timeout to prevent hanging after tests complete (CLM-34044) -->
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
          <!-- Force kill JVM after tests complete to prevent hanging from daemon threads (CLM-34044) -->
          <shutdown>kill</shutdown>
          <!--
            Intentional divergence from main: forkCount reduced from 0.75C to 0.375C (CLM-39214 Spring Boot migration).
            This branch boots Spring Boot application contexts in 18+ tests (main has 0). Combined with
            Jenkins's c6i.2xlarge agents (8 vCPU / 16 GB) and Maven 4-thread reactor parallelism, the main-aligned 0.75C
            caused OS-level memory pressure and agent SSH flapping. Revert to 0.75C once Spring test
            contexts are lighter or CI agents are larger.
          -->
          <forkCount>0.375C</forkCount>
          <!-- Heap set to 3G to prevent OOM during Spring Boot integration tests -->
          <argLine>@{argLine} -Xmx3072M -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar</argLine>
          <systemPropertyVariables>
            <!-- Used by the test MTIQ server to set the work directory (to not use the same work dir across all forks). -->
            <test.forkId>#${surefire.forkNumber}</test.forkId>
          </systemPropertyVariables>
          <!--
              insight-brain-service-[version]-server.jar!/META-INF/kie/*/kie.conf
              can conflict with kie.conf files in other dependencies
          -->
          <classpathDependencyExcludes>
            <classpathDependencyExclude>org.drools:drools-core</classpathDependencyExclude>
            <classpathDependencyExclude>org.drools:drools-compiler</classpathDependencyExclude>
            <classpathDependencyExclude>org.drools:drools-mvel</classpathDependencyExclude>
            <classpathDependencyExclude>org.kie:kie-internal</classpathDependencyExclude>
          </classpathDependencyExcludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-assembly-plugin</artifactId>
        <executions>
          <execution>
            <id>create-distro</id>
            <phase>package</phase>
            <goals>
              <goal>single</goal>
            </goals>
            <configuration>
              <!-- Skipped for non-bundling feature builds (-Dmtiq.package.skip=true): the distro
                   bundle tar.gz is not consumed by the test pipeline, only by the MTIQ image/release. -->
              <skipAssembly>${mtiq.package.skip}</skipAssembly>
              <descriptors>
                <descriptor>src/main/assembly/server-bundle.xml</descriptor>
              </descriptors>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-enforcer-plugin</artifactId>
        <dependencies>
          <dependency>
            <groupId>de.skuzzle.enforcer</groupId>
            <artifactId>restrict-imports-enforcer-rule</artifactId>
            <version>2.4.0</version>
          </dependency>
        </dependencies>
        <executions>
          <execution>
            <id>verify-bytecode-version</id>
            <phase>test</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <enforceBytecodeVersion>
                  <maxJdkVersion>${maven.compiler.target}</maxJdkVersion>
                  <includes>
                    <!-- the server is an uber JAR so we can exclude all its dependencies -->
                    <include>${project.groupId}:insight-brain-service</include>
                  </includes>
                </enforceBytecodeVersion>
              </rules>
            </configuration>
          </execution>
          <execution>
            <id>enforce-banned-import</id>
            <phase>process-sources</phase>
            <goals>
              <goal>enforce</goal>
            </goals>
            <configuration>
              <rules>
                <RestrictImports>
                  <reason>MultiTenantTestSupport in the `tenancy` module is only for multi-tenant tests outside of the
                    `nexus-mtiq-server` module</reason>
                  <bannedImport>com.sonatype.insight.brain.tenancy.MultiTenantTestSupport</bannedImport>
                </RestrictImports>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy</id>
            <phase>package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>io.opentelemetry.javaagent</groupId>
                  <artifactId>opentelemetry-javaagent</artifactId>
                  <type>jar</type>
                  <overWrite>true</overWrite>
                  <outputDirectory>${project.build.directory}</outputDirectory>
                  <destFileName>otel-java-agent.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip> <!-- this module produces Docker, not Java artifacts -->
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jreleaser</groupId>
        <artifactId>jreleaser-maven-plugin</artifactId>
        <version>${jreleaser.version}</version>
        <inherited>false</inherited>
        <configuration>
          <configFile>jreleaser.yml</configFile>
        </configuration>
      </plugin>
    </plugins>
  </build>

</project>
