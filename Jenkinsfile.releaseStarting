@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

pipeline {
  agent { label 'zion-small' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Announce Release is Starting') {
      steps {
        slackSend color: 'good', channel: '#releases-sca-core',
            message: "Starting IQ Server Release ${params.releaseVersion}."
      }
    }
  }
}
