                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">count2</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">4</property>
                    <property name="name">count3</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">5</property>
                    <property name="name">count4</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">6</property>
                    <property name="name">count5</property>
                    <property name="dataType">float</property>
                </structure>
            </list-property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">category</property>
                </structure>
                <structure>
                    <property name="columnName">count1</property>
                </structure>
                <structure>
                    <property name="columnName">count2</property>
                </structure>
                <structure>
                    <property name="columnName">count3</property>
                </structure>
                <structure>
                    <property name="columnName">count4</property>
                </structure>
                <structure>
                    <property name="columnName">count5</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">category</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">count1</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">count2</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">count3</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">count4</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">count5</property>
                        <property name="dataType">float</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">summary</property>
            <method name="open"><![CDATA[category = 0;

securityPunchCard = [];
for (var i = 0; ; i++) {
	var issues = data.securityPunchCard[i];
	if (!issues) {
		break;
	}
	if (i > 4) {
		securityPunchCard[4][0] += issues[0];
		securityPunchCard[4][1] += issues[1];
		securityPunchCard[4][2] += issues[2];
	} else {
		securityPunchCard.push(issues);
	}
}

maxSecCount = 1.0;
for (var i = 0; i < securityPunchCard.length; i++) {
	var issues = securityPunchCard[i];
	maxSecCount = Math.max(maxSecCount, issues[0]);
	maxSecCount = Math.max(maxSecCount, issues[1]);
	maxSecCount = Math.max(maxSecCount, issues[2]);
}

]]></method>
            <method name="fetch"><![CDATA[if (category == 3) {
	// right-most dummy bubble to ensure other bubbles are sized relative to the maximum value
	row["category"] = category;
	row["count1"] = row["count2"] = row["count3"] = row["count4"] = row["count5"] = 1.0;
	category++;
	return true;
}
if (category >= 3) {
	return false;
}

row["category"] = category;

for (var i = 0; i < 5; i++) {
	var j = i + 1;
	var count;
	if (i >= securityPunchCard.length) {
		count = 0;
	} else {
		count = securityPunchCard[i][category];
	}
	count = Math.sqrt(count / maxSecCount);
	if (count > 0) {
		count = Math.max(0.2, count);
	}
	row["count" + j] = count;
}

category++;

return true;
]]></method>
        </script-data-set>
