@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library', 'bnr-pipeline-library']) _

pipeline {
  agent { label 'zion-small' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Update In-Product Notifications') {
      steps {
        updateProductNotifications(params.releaseVersion)
      }
    }
  }
}
