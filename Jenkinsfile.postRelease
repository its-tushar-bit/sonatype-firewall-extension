Bump insight version number and follow instructions to release:
https://docs.sonatype.com/display/INT/Nexus+IQ+Bamboo+Plugin+Release+Process
      """,
        labels: ['iq-release-trigger', 'maintenance'],
        components: [[name: 'Bamboo']],
        priority: [name: 'Blocker', id: '1'],
