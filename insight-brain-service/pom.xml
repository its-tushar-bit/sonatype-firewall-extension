  <build>
    <plugins>
      <!-- We run the tests using maven-failsafe-plugin because we want to use the artifact jar, not the classes. -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <includes>
            <include>**/*Test.*</include>
          </includes>
          <trimStackTrace>false</trimStackTrace>
          <reuseForks>true</reuseForks>
          <forkedProcessTimeoutInSeconds>0</forkedProcessTimeoutInSeconds>
          <!-- 0.5C means 0.5 x number-of-CPUs:
                8 CPUs -> 4 forks
               16 CPUs -> 8 forks
           -->
          <forkCount>0.5C</forkCount>
          <argLine>@{argLine} -Xmx1536m -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar</argLine>
          <systemPropertyVariables>
            <!-- Used by the test IQ server to set the work directory (to not use the same work dir across all forks). -->
            <test.forkId>#${surefire.forkNumber}</test.forkId>
          </systemPropertyVariables>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.eclipse.sisu</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>index-service</id>
            <phase>process-classes</phase>
            <goals>
              <goal>index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>copy-fips-jars</id>
            <phase>prepare-package</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <artifactItems>
                <artifactItem>
                  <groupId>org.bouncycastle</groupId>
                  <artifactId>bc-fips</artifactId>
                  <outputDirectory>${project.build.directory}/fips-lib</outputDirectory>
                  <destFileName>bc-fips.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.bouncycastle</groupId>
                  <artifactId>bcpkix-fips</artifactId>
                  <outputDirectory>${project.build.directory}/fips-lib</outputDirectory>
                  <destFileName>bcpkix-fips.jar</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.bouncycastle</groupId>
                  <artifactId>bctls-fips</artifactId>
                  <outputDirectory>${project.build.directory}/fips-lib</outputDirectory>
                  <destFileName>bctls-fips.jar</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <createDependencyReducedPom>false</createDependencyReducedPom>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>server</shadedClassifierName>
              <artifactSet>
                <excludes>
                  <exclude>org.bouncycastle:bc-fips</exclude>
                  <exclude>org.bouncycastle:bcpkix-fips</exclude>
                  <exclude>org.bouncycastle:bctls-fips</exclude>
                </excludes>
              </artifactSet>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                    <exclude>module-info.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:org.eclipse.sisu.inject</artifact>
                </filter>
                <filter>
                  <artifact>*:h2</artifact>
                  <excludes>
                    <!-- using patched version from insight-brain-db instead, cf. CLM-13616 -->
                    <exclude>org/h2/value/ValueTimestamp.class</exclude>
                    <!-- using patched version from insight-brain-db instead, cf. CLM-15176 -->
                    <exclude>org/h2/engine/Session.class</exclude>
                    <!-- Exclude classes vulnerable to CVE-2018-14335.  See CLM-10571 -->
                    <exclude>org/h2/tools/Console*</exclude>
                    <exclude>org/h2/tools/Backup*</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:pdfbox2-layout</artifact>
                  <excludes>
                    <exclude>rst/pdfbox/layout/text/TextLine.class</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>com.fasterxml.jackson.core:*</artifact>
                  <excludes>
                    <exclude>META-INF/versions/19/**</exclude>
                    <exclude>META-INF/versions/21/**</exclude>
                  </excludes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sonatype.insight.brain.service.InsightBrainService</mainClass>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/insight/configuration.properties</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/kie.conf</resource>
                </transformer>
                <!-- Include FIPS JARs as embedded resources -->
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>lib/bc-fips.jar</resource>
                  <file>${project.build.directory}/fips-lib/bc-fips.jar</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>lib/bcpkix-fips.jar</resource>
                  <file>${project.build.directory}/fips-lib/bcpkix-fips.jar</file>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.IncludeResourceTransformer">
                  <resource>lib/bctls-fips.jar</resource>
                  <file>${project.build.directory}/fips-lib/bctls-fips.jar</file>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/PortAllocator*</include>
                <include>**/AbstractBaseIntegrationTest*</include>
                <include>**/HdsMockServerRule*</include>
                <include>**/DefaultTestInsightBrainService*</include>
                <include>**/MultiTenantBrainServiceTestService*</include>
                <include>**/*InsightBrainServiceFactory*</include>
                <include>**/TestInsightBrainService*</include>
                <include>**/TestInsightBrainServiceRule*</include>
                <include>**/TestCLMServer*</include>
                <include>**/AbstractResourceTest*</include>
                <include>**/TestLicenseFingerprinter*</include>
                <include>**/TestProductLicense*</include>
                <include>**/TestProductLicenseManager*</include>
                <include>**/TestProductLicenseDetailsCache/*.json</include>
                <include>**/TestQuartzJobStoreTx*</include>
                <include>**/TestTaskScheduler*</include>
                <include>**/QuartzJobSchedulingServiceRule**</include>
                <include>**/productlicense/license.lic</include>
                <include>**/SlowMoFilter*</include>
                <include>**/RestRequestFilter*</include>
                <include>**/TemporaryEntity*</include>
                <include>**/HttpRequest*</include>
                <include>**/HttpResponse*</include>
                <include>**/ReportHelper*</include>
                <include>**/ScanHelper*</include>
                <include>**/Zipper*</include>
                <include>**/EmbeddedLdapServer*</include>
                <include>**/TestLdapServer*</include>
                <include>**/NetworkingHelper*</include>
                <include>**/SslSettings*</include>
                <include>**/ReportTestUtils*</include>
                <include>**/CrowdMockServerRule*</include>
                <include>**/ArtifactoryMockServerRule*</include>
                <include>**/AbstractAuditTest*</include>
                <include>**/AbstractResourceAuthzTest*</include>
                <include>**/AbstractComponentTest*</include>
                <include>**/BrainInjectedTest*</include>
                <include>**/AuditTestSupport*</include>
                <include>**/TestAuditSession*</include>
                <include>**/MockCleaner*</include>
                <include>**/*Test*</include>
                <include>**/DatabaseContainerRule*</include>
                <include>**/H2InMemoryDatabaseConfigProvider*</include>
                <include>**/JWTGenerator*</include>
                <include>**/FunctionUtils*</include>
                <include>**/VulnerabilitySignatureAnalysisDTOHelper*</include>
                <include>**/ZScalerMockServerRule*</include>
                <include>**/*SearchIndexFixture*</include>
                <include>**/SearchIndexRule*</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <configuration>
          <excludes>**/rst/**</excludes>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-pmd-plugin</artifactId>
        <configuration>
          <excludes>
            <exclude>**/rst/**</exclude>
          </excludes>
        </configuration>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.eclipse.sisu</groupId>
                    <artifactId>sisu-maven-plugin</artifactId>
                    <versionRange>[0.3.3,)</versionRange>
                    <goals>
                      <goal>index</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <profile>
      <id>idea</id>
      <properties>
      </properties>
    </profile>
    <profile>
      <id>test-only-properties</id>
      <activation>
        <property>
          <name>!build.number</name>
        </property>
      </activation>
      <properties>
        <build.number>build-number</build.number>
      </properties>
    </profile>
  </profiles>
</project>
