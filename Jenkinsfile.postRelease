@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Create Integration Jira Tickets') {
      steps {
        createIntegrationTicketsAfterIQRelease()
      }
    }
    stage('Update Test Instance') {
      steps {
        build('job': 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/staging',
            parameters: [string(name: 'IQ_VERSION', value: 'latest')])

        build('job': 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/staging')
      }
    }
    stage('Update Production Instance') {
      steps {
        build('job': 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/production',
            parameters: [string(name: 'IQ_VERSION', value: 'latest')])

        build('job': 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/production')
      }
    }
  }
}

def createIntegrationTicketsAfterIQRelease() {
  List<Map> tickets = getTickets()
  tickets.each { Map fields ->
    def newIssue = jiraNewIssue issue: [fields: fields], site: 'issues.sonatype.com'
    echo "New issue created: ${newIssue.data.key}"
  }
}

