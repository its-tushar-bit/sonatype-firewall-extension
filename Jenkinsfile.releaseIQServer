@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties(
  [
    parameters (
      [
        booleanParam(name: 'hotfix', defaultValue: 'false', description: 'Check if this IQ Release is intended to be a hotfix e.g. urgent release to fix a severe bug. (Used for internal metrics only.)'),
        string (name: 'releaseVersion', defaultValue: '',description: 'The version number for the product, like "1.118.0-01"')
      ]
    )
  ]
)

pipeline {
  agent { label InsightConstants.AGENT_LABEL }

  environment {
    minorVersion = "${parseVersion(params.releaseVersion)?.minor}"
  }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Announce Release is Starting') {
      steps {
        build(job: 'insight/insight-brain/Release Starting',
          parameters: [string(name: 'releaseVersion', value: env.minorVersion)])
      }
    }
    stage('Stage Release Binaries') {
      steps {
        triggerBuildAndVerifySafeToContinuePipeline(
          'insight/insight-brain/release',
          [
              booleanParam(name: 'hotfix', value: params.hotfix),
              string(name: 'version', value: params.releaseVersion)
          ]
        )
      }
    }
    stage('Release Jira Version - IQ') {
      steps {
        build(job: 'insight/insight-brain/Release JIRA Version',
          parameters: [string(name: 'releaseVersion', value: env.minorVersion)])
      }
    }
    stage('Release Jira Version - Integrations') {
      steps {
        build(job: 'integrations/Set Jira Fix Version/',
          parameters: [string(name: 'prefix', value: 'brain'), string(name: 'version', value: env.minorVersion)])
      }
    }
    stage('Deploy to staging') {
      steps {
        build(
          job: 'insight/insight-brain/deploy',
          parameters: [
            string(name: 'environment', value: 'Staging'),
            run(name: 'releaseBuild', runId: "insight/insight-brain/release#${getReleaseJobForVersion('insight/insight-brain/release', params.releaseVersion)}")
          ]
        )
      }
    }
    stage('Deploy to Production') {
      steps {
        build(
          job: 'insight/insight-brain/deploy',
          parameters: [
            string(name: 'environment', value: 'Production'),
            run(name: 'releaseBuild', runId: "insight/insight-brain/release#${getReleaseJobForVersion('insight/insight-brain/release', params.releaseVersion)}")
          ]
        )
      }
    }
    stage('Publish Release Notes & Documentation') {
      steps {
        build(job: 'insight/insight-brain/Publish Documentation')
      }
    }
    stage('Create Product Notification') {
      steps {
        build(job: 'insight/insight-brain/Update Product Notifications',
          parameters: [string(name: 'releaseVersion', value: env.minorVersion)])
      }
    }
    stage('Deploy Product Notification - Staging') {
      steps {
        build(job: 'insight/hosted-data-services/Sync Product Notifications',
          parameters: [string(name: 'ENVIRONMENT', value: 'staging')])
      }
    }
    stage('Deploy Product Notification - Production') {
      steps {
        build(job: 'insight/hosted-data-services/Sync Product Notifications',
          parameters: [string(name: 'ENVIRONMENT', value: 'production')])
      }
    }
    stage('Send Policy Results') {
      steps {
        build(job: 'insight/insight-brain/Send Policy Results',
          parameters: [string(name: 'releaseVersion', value: env.minorVersion)])
      }
    }
    stage('Publish CloudFormation Templates') {
      steps {
        build(
            job: 'integrations/cloud/nexus-iq-ha-reference',
            parameters: [
                run(name: 'releaseBuild', runId: "insight/insight-brain/release#${getReleaseJobForVersion('insight/insight-brain/release', params.releaseVersion)}")
            ]
        )
      }
    }
    stage('Publish Docker Image') {
      steps {
        triggerBuildAndVerifySafeToContinuePipeline(
            'insight/insight-brain/docker/docker-nexus-iq-server',
            [run(name: 'releaseBuild', runId: "insight/insight-brain/release#${getReleaseJobForVersion('insight/insight-brain/release', params.releaseVersion)}")]
        )
      }
    }
    stage('Send Release Notifications') {
      steps {
        build(job: 'insight/insight-brain/Release Notification',
          parameters: [string(name: 'releaseVersion', value: env.minorVersion)])
      }
    }
    stage('Post Release Tasks') {
      steps {
        build(job: 'insight/insight-brain/post-release', propagate: false,
              parameters: [string(name: 'releaseVersion', value: params.releaseVersion)])
      }
    }
  }
}

def triggerBuildAndVerifySafeToContinuePipeline(String buildName, List<?> params) {
  def job = build(job: buildName, parameters: params, propagate: false)

  def result = job.getCurrentResult()
  if (result == 'ABORTED' || result == 'FAILURE') {
    error("Stopping IQ Release Pipeline")
  }

  // build can be unstable due to policy violation or test failure.
  // we want to stop pipeline if unstable due to test failures
  if (result == 'UNSTABLE') {
    def failCount = getTestResults(job).failCount
    if (failCount > 0) {
      error("Stopping IQ Release Pipeline due to failing tests on ${buildName}")
    }
  }
}
