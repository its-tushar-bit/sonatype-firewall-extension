                            <property name="display">inline</property>
                            <method name="onCreate"><![CDATA[var svLevel = this.getRowData().getColumnValue("svLevel");
var bgColor, borderColor;
if (svLevel >= 7) {
	bgColor = "#bc012f";
	borderColor = "#B71218";
} else if (svLevel >= 4) {
	bgColor = "#f4861d";
	borderColor = "#C67A22";
} else if (svLevel >= 0 || this.getRowData().getColumnValue("svCount") > 0) {
	bgColor = "#f5c648";
	borderColor = "#DDBE18";
} else {
	bgColor = "#D9DADE";
	borderColor = "#84858A";
}
this.getStyle().backgroundColor = bgColor;
this.getStyle().borderBottomColor = borderColor;
this.getStyle().borderTopColor = borderColor;
this.getStyle().borderLeftColor = borderColor;
this.getStyle().borderRightColor = borderColor;
]]></method>
                            <property name="contentType">html</property>
                            <text-property name="content"><![CDATA[<VALUE-OF>
(row["svCount"] > 0) ? (row["svLevel"] >= 0 ? row["svLevel"] : "Unscored") : "NA"
</VALUE-OF>]]></text-property>
                        </text>
