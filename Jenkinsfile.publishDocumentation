@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library', 'bnr-pipeline-library']) _

pipeline {
  agent { label 'zion-small' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Publish Nexus IQ Server documentation') {
      steps {
        publishConfluencePages('NXIQM')
      }
    }
    stage('Publish Nexus IQ - Integrations documentation') {
      steps {
        publishConfluencePages('NXIM')
      }
    }
    stage('Publish Nexus IQ - Firewall documentation') {
      steps {
        publishConfluencePages('FWM')
      }
    }
  }
}
