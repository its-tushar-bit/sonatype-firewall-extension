  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>src/main/resources-filtered</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/policy/js/</targetPath>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/assets/js/</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.sonatype.plugins</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <executions>
          <execution>
            <id>index-service</id>
            <phase>process-classes</phase>
            <goals>
              <goal>index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-XX:MaxPermSize=128m</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.searls</groupId>
        <artifactId>jasmine-maven-plugin</artifactId>
        <version>1.2.0.0</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <id>test-policy-assets</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <sourceIncludes>
            <include>assets/jquery/jquery-*.min.js</include>
            <include>assets/bootstrap/bootstrap-*.min.js</include>
            <include>assets/angular/angular-*.min.js</include>
            <include>assets/angular/angular-sanitize-*.min.js</include>
            <include>assets/CLMLocation.js</include>
            <include>assets/AngularCommon.js</include>
            <include>policy/PolicyApp.js</include>
            <include>policy/InsightPolicyController.js</include>
            <include>policy/InsightLicenseGroupController.js</include>
            <include>policy/LabelController.js</include>
            <include>policy/js/cip-label-editor.js</include>
            <include>policy/js/notification-management.js</include>
            <include>application/ClmManagementApp.js</include>
            <include>application/ManagementController.js</include>
          </sourceIncludes>
          <specIncludes>
            <include>assets/angular-mocks-*.js</include>
            <include>assets/MockData.js</include>
            <include>policy/PolicyMockData.js</include>
            <include>policy/LicenseGroupMockData.js</include>
            <include>policy/InsightPolicyControllerSpec.js</include>
            <include>policy/InsightLicenseGroupControllerSpec.js</include>
            <include>policy/CIPLabelEditorSpec.js</include>
            <include>policy/LabelControllerSpec.js</include>
            <include>policy/notification-management-spec.js</include>
            <include>application/ApplicationMockData.js</include>
            <include>application/ManagementControllerSpec.js</include>
            <include>assets/AngularCommonSpec.js</include>
          </specIncludes>
          <jsSrcDir>${project.basedir}/src/main/resources/assets</jsSrcDir>
          <jsTestSrcDir>${project.basedir}/src/test/resources/assets</jsTestSrcDir>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>server</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:sisu-inject-bean</artifact>
                  <excludes>
                    <!-- avoid conflict with same resource from BIRT -->
                    <exclude>plugin.xml</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:org.eclipse.birt.runtime</artifact>
                  <includes>
                    <include>*.xml</include>
                    <include>org/eclipse/**</include>
                    <include>javax/**</include>
                  </includes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sonatype.insight.brain.service.InsightBrainService</mainClass>
                  <manifestEntries>
                    <!-- Required by BIRT to discover the extensions we have shaded in -->
                    <Bundle-SymbolicName>${project.groupId}.server</Bundle-SymbolicName>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/AbstractBrainServiceTest*</include>
                <include>**/TestInsightBrainService*</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.searls</groupId>
                    <artifactId>jasmine-maven-plugin</artifactId>
                    <versionRange>[1.2.0.0,)</versionRange>
                    <goals>
                      <goal>test</goal>
                      <goal>testResources</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.sonatype.plugins</groupId>
                    <artifactId>sisu-maven-plugin</artifactId>
                    <versionRange>[1.0,)</versionRange>
                    <goals>
                      <goal>index</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
