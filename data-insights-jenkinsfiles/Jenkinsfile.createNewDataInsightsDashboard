// This job allows the Business Intelligence team control what is shown on the Insight Data landing page in IQ
// Some more technical background can be found here https://sonatype.atlassian.net/wiki/spaces/DATA/pages/227410489/Dashboard+Change+Management
// The job can be ran here: https://jenkins.ci.sonatype.dev/job/insight/job/insight-brain/job/Data%20Insights%20Dashboard%20Configuration/job/Create%20Or%20Update%20Data%20Insights%20Dashboard/

@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _
import groovy.json.JsonSlurper

def fileName = "enterprise-reporting.json"

def s3Configuration =  [
    account: "993883856687",
    role: 'jenkins-hds-enterprise-reporting-staging',
    credentialsId: 'hds-enterprise-reporting-external-id-staging',
    usEast2Bucket: "hds-staging-enterprise-reporting-us-east-2",
    usWest2Bucket: "hds-staging-enterprise-reporting-us-west-2"
]

pipeline {
  agent {
    node {
      label 'zion-small'
    }
  }

  stages {
    stage('Create/Update Data Insights Dashboard For usEast2Bucket Staging') {
      steps {
        script {
          withAwsRole(region: 'us-east-2', role: s3Configuration.role, roleAccount: s3Configuration.account, credentialsId: s3Configuration.credentialsId) {
            printUserInput(params)

            def bucketForStagingEast = s3Configuration.usEast2Bucket

            createConfigurationFileIfNotExists(bucketForStagingEast, fileName)

            def dashboardConfig = readExistingConfig(bucketForStagingEast, fileName)

            validateInput(params, dashboardConfig)

            def dashboardEntry = [
              dashboardId: params.dashboardId,
              title: params.title,
              category: params.category,
              description: params.description,
              dashboardPath: params.dashboardPath,
              sinceIQVersion: covertEmtpyToNull(params.sinceIQVersion),
              modelsCsv: params.modelsCsv,
              featuresCsv: params.featuresCsv,
              accessButtonText: params.accessButtonText,
              previewImageFilename: params.previewImageFilename,
              previewImageIcon: params.previewImageIcon,
              priorityOrder: params.priorityOrder.toInteger(),
              spotlightColor: covertEmtpyToNull(params.spotlightColor),
              spotlight: params.spotlight,
              spotlightText: params.spotlightText
            ]

            dashboardConfig.version = dashboardConfig.version + 1
            dashboardConfig.dashboards[params.dashboardId] = dashboardEntry

            def newDashboardConfigJson = groovy.json.JsonOutput.toJson(dashboardConfig)

            // pretty print for convenience
            echo "new configuration state:"
            echo writeJSON(returnText: true, json: dashboardConfig, pretty: 2)

            // dump raw, just in case
            echo "saving new configuration: ${newDashboardConfigJson}"
            saveToBucket(bucketForStagingEast, fileName, newDashboardConfigJson)
          }
        }
      }
    }

    stage('Copy from usEast2Bucket Staging bucket to usWest2Bucket Staging bucket') {
      steps {
        script {
          withAwsRole(region: 'us-east-2', role: s3Configuration.role, roleAccount: s3Configuration.account, credentialsId: s3Configuration.credentialsId) {
            copyFromEastBucketToWestBucket(s3Configuration, fileName)
          }
        }
      }
    }
  }

  parameters {
    string(
        name: 'dashboardId',
        description: ' The primary identifier used to determine which dashboard is updated. If no dashboard exists ' +
            'with the id, a new dashboard is created (Provided by BI team).',
        trim: true,
        defaultValue: ''
    )

    // Ordered alphabetically

    string(
        name: 'accessButtonText',
        description: 'Dashboard access button text (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: ''
    )

    choice(
        name: 'category',
        choices: ['enterprise', 'dataInsight'],
        description: 'Select the category for the dashboard (Provided by UI/UX Design team).'
    )

    string(
        name: 'dashboardPath',
        description: 'The Looker path to link to. It starts with "dashboards/" (Provided by BI team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'description',
        description: 'Dashboard description (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'featuresCsv',
        description: 'Dashboard features, provide as a comma separated list -- no space after commas (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'modelsCsv',
        description: 'Looker data, provide as a comma separated list -- no space after commas (Provided by BI team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'title',
        description: 'Dashboard title (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'previewImageFilename',
        description: 'Dashboard icon file name (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'previewImageIcon',
        description: 'Dashboard icon name (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: ''
    )

    string(
        name: 'priorityOrder',
        description: 'Dashboard priority, used order the dashboards on the page (Provided by UI/UX Design team).',
        trim: true,
        defaultValue: '0'
    )

    string(
        name: 'sinceIQVersion',
        description: 'The minimum IQ version required for this feature -- optional (Provided by BI team).',
        trim: true
    )

    booleanParam(
        name: 'spotlight',
        description: 'Will highlight a dashboard as being “new“ (Provided by UI/UX Design team).',
        defaultValue: false,
    )

    string(
        name: 'spotlightColor',
        description: 'A optional customer color for "new" tag shown in the UI (Provided by UI/UX Design team).',
        trim: true
    )

    string(
        name: 'spotlightText',
        description: 'A optional text for the tag shown in the UI (Provided by UI/UX Design team).',
        trim: true
    )
  }
}

def createConfigurationFileIfNotExists(bucketName, fileName) {
  def base_file_template = '{ \\"version\\": 1, \\"dashboards\\": {} }'

  sh """
    aws s3api head-object --bucket ${bucketName} --key ${fileName} > /dev/null 2>&1 || not_exist=true
    if [ \$not_exist ]; then
        echo "${fileName} does not exist and will be created for bucket ${bucketName}"

        echo ${base_file_template} | aws s3 cp - s3://${bucketName}/${fileName}
    else
        echo "${fileName} exists ✔️"
    fi
    """
}

def readExistingConfig(bucketForStagingEast, fileName) {
  def dashboardConfigJson = getFileContents(bucketForStagingEast, fileName)

  echo "existing configuration: ${dashboardConfigJson}"

  return new JsonSlurper().parseText(dashboardConfigJson)
}

def getFileContents(bucketName, fileName) {
  return sh(script: "aws s3 cp s3://${bucketName}/${fileName} -", returnStdout: true).trim()
}

def saveToBucket(bucketName, fileName, contents) {
  sh """
cat <<EOF | aws s3 cp - s3://${bucketName}/${fileName}
${contents}
EOF
  """
}

def copyFromEastBucketToWestBucket(s3Configuration, fileName) {
  def bucketForStagingEast = s3Configuration.usEast2Bucket
  def bucketForStagingWest = s3Configuration.usWest2Bucket

  echo "copying s3://${bucketForStagingEast}/${fileName} to s3://${bucketForStagingWest}/${fileName}"

  sh "aws s3 cp s3://${bucketForStagingEast}/${fileName} s3://${bucketForStagingWest}/${fileName}"
}

def printUserInput (params) {
  echo "User Inputs ->"
  echo "  dashboardId: ${params.dashboardId}"
  echo "  category: ${params.category}"
  echo "  title: ${params.title}"
  echo "  description: ${params.description}"
  echo "  dashboardPath: ${params.dashboardPath}"
  echo "  sinceIQVersion: ${params.sinceIQVersion}"
  echo "  modelsCsv: ${params.modelsCsv}"
  echo "  featuresCsv: ${params.featuresCsv}"
  echo "  accessButtonText: ${params.accessButtonText}"
  echo "  previewImageFilename: ${params.previewImageFilename}"
  echo "  previewImageIcon: ${params.previewImageIcon}"
  echo "  priorityOrder: ${params.priorityOrder}"
  echo "  spotlightColor: ${params.spotlightColor}"
  echo "  spotlight: ${params.spotlight}"
  echo "  spotlight: ${params.spotlightText}"
}

def validateInput(params, existingConfig) {
  validateRequiredFields(params)

  if (!params.priorityOrder.isNumber()) {
    error "Invalid input: priorityOrder must be a number."
  }

  assertThatNewPriorityOrderIsUnique(existingConfig, params.dashboardId, params.priorityOrder.toInteger())
}

def validateRequiredFields(params) {
  // spotlightColor and sinceIQVersion are optional and not validated here
  validateFieldHasValue(params, 'dashboardId')
  validateFieldHasValue(params, 'category')
  validateFieldHasValue(params, 'title')
  validateFieldHasValue(params, 'description')
  validateFieldHasValue(params, 'dashboardPath')
  validateFieldHasValue(params, 'modelsCsv')
  validateFieldHasValue(params, 'featuresCsv')
  validateFieldHasValue(params, 'accessButtonText')
  validateFieldHasValue(params, 'previewImageFilename')
  validateFieldHasValue(params, 'previewImageIcon')
  validateFieldHasValue(params, 'priorityOrder')
}

// assume field has a value and no padding because all our parameters have defaults and trim enabled
def validateFieldHasValue(params, fieldName) {
  if (params[fieldName].length() == 0) {
    error "'${fieldName}' is a required field"
  }
}

def assertThatNewPriorityOrderIsUnique(existingConfig, specifiedDashboardId, newPriorityOrder) {
  def dashboards = existingConfig.dashboards

  dashboards.each { dashboardId, dashboard ->
    if (dashboardId != specifiedDashboardId && newPriorityOrder == dashboard.priorityOrder) {
      error "Priority orders should be unique, the provided value ${newPriorityOrder} conflicts with the priority of " +
          "dashboardId ${dashboardId}"
    }
  }
}

def covertEmtpyToNull(String value) {
  if (value == null || value.length() == 0) {
    return null
  } else {
    return value
  }
}
