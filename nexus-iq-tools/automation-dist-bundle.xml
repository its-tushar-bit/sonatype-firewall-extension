<assembly>
  <id>automation</id>
  <baseDirectory>automation</baseDirectory>
  <includeBaseDirectory>true</includeBaseDirectory>
  <formats>
    <format>zip</format>
  </formats>
  <fileSets>
    <fileSet>
      <directory>automation</directory>
      <outputDirectory>.</outputDirectory>
      <filtered>true</filtered>
      <includes>
        <include>Pipfile</include>
        <include>Pipfile.lock*</include>
        <include>*.py</include>
        <include>*.json</include>
      </includes>
    </fileSet>
  </fileSets>
</assembly>
