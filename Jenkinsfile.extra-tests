@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

String agentLabel = 'ubuntu-zion'

def testConfig(String mavenOptions, String pomFile = null) {
  return mavenCommon(javaVersion: 'Java 8', mavenVersion: 'Maven 3.2.x', useEventSpy: false,
      pomFile: pomFile, mavenOptions: mavenOptions)
}

def copyRepo() {
  copyArtifacts(projectName: currentBuild.upstreamBuilds[0].fullProjectName,
    filter: '.zion/repository/**',
    selector: specific(currentBuild.upstreamBuilds[0].id),
    flatten: false)
}

def gebTests() {
  copyRepo()
  def testConfig = testConfig('-Dgeb.env=ci', 'insight-brain-functional-test/pom.xml')
  mvn testConfig, 'clean test'
}

def functionalTests(String browser, String testRegex) {
  copyRepo()
  withCredentials([string(credentialsId: 'APPLITOOLS_KEY', variable: 'applitoolsKey')]) {
    String mavenOptions = "'-Dit.test=%regex[${testRegex}]'"
    mavenOptions += ' -Drun-functional-tests=docker'
    mavenOptions += " -Dbrowser=${browser}"
    mavenOptions += " -DapplitoolsKey=${applitoolsKey}"
    def testConfig = testConfig(mavenOptions, 'insight-brain-java-functional-test/pom.xml')
    mvn testConfig, 'clean verify'
  }
}

def unitTests() {
  def testConfig = testConfig('-Dskip-functional-test')
  mvn testConfig, 'clean install'
}

def captureResultsAndCleanup() {
  archiveArtifacts(artifacts: '**/target/*-reports/**', excludes: '**/*.xml, **/*-output.txt')
  collectTestResults(['**/target/*-reports/*.xml'])
  deleteDir()
}

pipeline {
  agent { label agentLabel }
  options {
    buildDiscarder(
        logRotator(numToKeepStr: '100', daysToKeepStr: '14', artifactNumToKeepStr: '20', artifactDaysToKeepStr: '10')
    )
    timestamps()
  }
  environment {
    // For the applitools github integration
    APPLITOOLS_BATCH_ID = "${env.GIT_COMMIT}"
  }
  stages {
    stage('Parallel Test Groups') {
      parallel {
        stage('Geb Functional Tests') {
          agent { label agentLabel }
          steps {
            gebTests()
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Java Functional Tests - (Chrome) A') {
          agent { label agentLabel }
          steps {
            functionalTests('chrome', '.*/[A-M].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Java Functional Tests - (Chrome) B') {
          agent { label agentLabel }
          steps {
            functionalTests('chrome', '.*/[N-Z].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        // Firefox runs about twice as slow as chrome so splitting the tests into 4 parallel tests taking careful 
        // consideration into grouping tests to balance out test execution run times. 
        stage('Java Functional Tests - (Firefox) A') {
          agent { label agentLabel }
          environment {
            bamboo_planRepository_branchName = "${gitBranch(env)}"
            bamboo_buildNumber = "${env.BUILD_NUMBER}"
          }
          steps {
            functionalTests('firefox', '.*/[A-B].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Java Functional Tests - (Firefox) B') {
          agent { label agentLabel }
          environment {
            bamboo_planRepository_branchName = "${gitBranch(env)}"
            bamboo_buildNumber = "${env.BUILD_NUMBER}"
          }
          steps {
            functionalTests('firefox', '.*/[C-D].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Java Functional Tests - (Firefox) C') {
          agent { label agentLabel }
          environment {
            bamboo_planRepository_branchName = "${gitBranch(env)}"
            bamboo_buildNumber = "${env.BUILD_NUMBER}"
          }
          steps {
            functionalTests('firefox', '.*/[E-O].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Java Functional Tests - (Firefox) D') {
          agent { label agentLabel }
          environment {
            bamboo_planRepository_branchName = "${gitBranch(env)}"
            bamboo_buildNumber = "${env.BUILD_NUMBER}"
          }
          steps {
            functionalTests('firefox', '.*/[P-Z].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Unit and Integration Tests') {
          agent { label agentLabel }
          steps {
            unitTests()
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
      }
    }
  }
}
