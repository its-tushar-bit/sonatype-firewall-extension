  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated</directory>
      </resource>
      <resource>
        <directory>src/main/filtered-resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/policy/js/</targetPath>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/assets/js/</targetPath>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.sonatype.plugins</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <!-- Use 1.1 because: https://github.com/sonatype/insight-brain/commit/63133339 -->
        <version>1.1</version><!--$NO-MVN-MAN-VER$-->
        <executions>
          <execution>
            <id>index-service</id>
            <phase>process-classes</phase>
            <goals>
              <goal>index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <argLine>-XX:MaxPermSize=144m</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.klieber</groupId>
        <artifactId>phantomjs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.searls</groupId>
        <artifactId>jasmine-maven-plugin</artifactId>
        <version>${jasmine.version}</version>
        <extensions>true</extensions>
        <!-- Only the last execution of this plugin is subject to collection of coverage information, unfortunately. -->
        <executions>
          <execution>
            <id>${jasmine.cip.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <preloadSources>
                <source>resources/assets/cip/cip-test-util.js</source>
                <include>frontend/lib/jquery/jquery.js</include>
                <include>frontend/lib/bootstrap/bootstrap-2.3.1.min.js</include>
                <include>frontend/lib/angular/angular.js</include>
                <include>frontend/lib/angular-${angularjs.version}/angular-route.js</include>
                <include>frontend/lib/angular-${angularjs.version}/angular-sanitize.js</include>
                <include>frontend/lib/angular-vs-repeat/src/angular-vs-repeat.js</include>
                <include>frontend/lib/angular-ui-router-0.2.15.min.js</include>
                <include>wro4j/cip/cip-loader.js</include>
              </preloadSources>
              <sourceIncludes>
                <include>brain-client/*.js</include>
                <include>wro4j/cip/**/*module.js</include>
                <include>wro4j/cip/*.js</include>
                <include>wro4j/cip/**/*.js</include>
                <include>wro4j/audit-report/cip/cip.vulnerability.editor/*module.js</include>
                <include>wro4j/audit-report/cip/cip.vulnerability.editor/*.js</include>
                <include>wro4j/audit-report/cip/vulnerability.details/*module.js</include>
                <include>wro4j/audit-report/cip/vulnerability.details/*.js</include>
                <include>frontend/utility/directives/utility.directives.module.js</include>
                <include>frontend/utility/directives/load.wrapper.directive.js</include>
                <include>frontend/utility/services/utility.services.module.js</include>
                <include>frontend/utility/services/unauthenticated.request.queue.service.js</include>
                <include>frontend/utility/services/login.modal.controller.js</include>
                <include>frontend/utility/services/login.modal.service.js</include>
                <include>frontend/util/AngularCommon.js</include>
                <include>frontend/util/CLMAppLocation.js</include>
                <include>frontend/util/CLMLocation.js</include>
                <include>frontend/util/HttpInterceptors.js</include>
                <include>frontend/lib/ui-bootstrap-tpls-0.13.4.min.js</include>
                <include>frontend/lib/datepicker/bootstrap-datepicker.js</include>
              </sourceIncludes>
              <sourceExcludes>
                <exclude>frontend/lib/bootstrap-sass-official/**/*.js</exclude>
              </sourceExcludes>
              <specIncludes>
                <include>frontend/SpecUtil.js</include>
                <include>frontend/**/lib/*.js</include>
                <include>frontend/**/*MockData.js</include>
                <include>resources/assets/cip/**/*.js</include>
                <include>resources/assets/**/cip*.js</include>
                <include>resources/assets/**/CIP*.js</include>
                <include>resources/assets/brain-client/*.js</include>
              </specIncludes>
              <junitXmlReportFileName>TEST-cip.xml</junitXmlReportFileName>
            </configuration>
          </execution>
