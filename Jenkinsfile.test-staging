@Library(['jenkins-shared', 'iq-pipeline-library']) _

/**
 * Post-deployment smoke tests against staging cell.
 *
 * Triggered as a downstream job from Jenkinsfile.deploy-to-staging after successful deployments.
 * Runs the mtiq-apps PostDeploymentSmokeTest against the cicd tenant.
 *
 * Prerequisites:
 *   - Jenkins credential 'mtiq-prod-internal-mirror-smoke-test-user' (Username with Password)
 *   - Tenant 'cicd' provisioned on staging with dual (Firewall + Lifecycle) license
 *
 * Parameters:
 *   IMAGE_TAG - The ECR tag that was just deployed (for traceability/reporting)
 */

pipeline {
  agent { label 'zion-small' }

  parameters {
    string(name: 'IMAGE_TAG', description: 'The ECR tag that was deployed (for traceability)')
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '20'))
    timeout(time: 30, unit: 'MINUTES')
    disableConcurrentBuilds()
  }

  tools {
    jdk 'OpenJDK 17'
  }

  stages {
    stage('Validate Parameters') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'IMAGE_TAG parameter is required'
          }
          echo "Testing image tag: ${params.IMAGE_TAG}"
        }
      }
    }

    stage('Checkout mtiq-tools') {
      steps {
        dir('mtiq-tools') {
          checkout([$class: 'GitSCM',
                    branches: [[name: '*/main']],
                    userRemoteConfigs: [[url: 'git@github.com:sonatype/mtiq-tools.git',
                                        credentialsId: sonatypeZionCredentialsId()]]])
        }
      }
    }

    stage('Build') {
      steps {
        dir('mtiq-tools/mtiq-load-testing') {
          withMaven(jdk: 'OpenJDK 17', maven: 'Maven 3.9.x', mavenSettingsConfig: 'private-settings.xml') {
            sh 'mvn clean install -DskipTests'
          }
        }

        dir('mtiq-tools/mtiq-apps') {
          withMaven(jdk: 'OpenJDK 17', maven: 'Maven 3.9.x', mavenSettingsConfig: 'private-settings.xml') {
            sh 'mvn clean install -P smoke'
          }
        }
      }
    }

    stage('Smoke Test') {
      steps {
        dir('mtiq-tools/mtiq-load-testing') {
          withCredentials([usernamePassword(credentialsId: 'mtiq-prod-internal-mirror-smoke-test-user',
              usernameVariable: 'mtiqUser', passwordVariable: 'mtiqPwd')]) {
            sh '''
                java -jar ../mtiq-apps/target/mtiq-apps-1.0-SNAPSHOT.jar \
                  --env=staging \
                  --id=cicd \
                  --url=https://cicd.staging.iq.saas.sonatype.dev \
                  --user=${mtiqUser} \
                  --pwd=${mtiqPwd} \
                  run
                '''
          }
        }
      }
    }

    stage('Trigger deploy-to-prod-internal') {
      steps {
        script {
          build job: 'insight/MTIQ/sca-cloud/deploy-to-prod-internal',
              parameters: [string(name: 'IMAGE_TAG', value: params.IMAGE_TAG)],
              wait: false,
              propagate: false
        }
      }
    }
  }

  post {
    always {
      archiveArtifacts artifacts: 'mtiq-tools/mtiq-load-testing/**/mtiq-*-report-*.html', allowEmptyArchive: true
    }
    success {
      echo "Smoke tests passed for image tag: ${params.IMAGE_TAG}"
    }
    failure {
      script {
        echo "Smoke tests failed for image tag: ${params.IMAGE_TAG}"
        notifyChat(currentBuild: currentBuild, env: env, room: 'mtiq-notices',
                   message: "Staging smoke tests FAILED for image tag: ${params.IMAGE_TAG}")
      }
    }
  }
}
