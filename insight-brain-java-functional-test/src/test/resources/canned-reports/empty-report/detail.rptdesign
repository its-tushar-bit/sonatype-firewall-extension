        <script-data-set name="licenseCounts" id="542">
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">1</property>
                    <property name="name">count</property>
                    <property name="dataType">float</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">category</property>
                    <property name="dataType">integer</property>
                </structure>
            </list-property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">count</property>
                </structure>
                <structure>
                    <property name="columnName">category</property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">count</property>
                        <property name="dataType">float</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">category</property>
                        <property name="dataType">integer</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">summary</property>
            <method name="open"><![CDATA[index = 0;

var total = 0;
var criticalCount = 0;
var severeCount = 0;
var moderateCount = 0;
var noThreatCount = 0;

for (var i = 0; i < data.effectiveLicenseCounts.length; i++) {
	var item = data.effectiveLicenseCounts[i];
	if (i > 7) {
		criticalCount += item;
	} else if (i > 3) {
		severeCount += item;
	} else if (i > 0) {
		moderateCount += item;
	} else {
		noThreatCount += item;
	}
	total += item;
}

total = Math.max(1, total);

fractions = [];
fractions.push(criticalCount / total);
fractions.push(severeCount /  total);
fractions.push(moderateCount / total);
fractions.push(noThreatCount / total);

// for better look, ensure very small positive values show up as at least 1%
var maxData = -1, totalExtra = 0;
for (var i = 0; i < fractions.length; i++) {
	if (maxData < 0 || fractions[i] >= fractions[maxData]) {
		maxData = i;
	}
	if (fractions[i] <= 0) {
		// The PDF/SVG renderer crashes if a slice is of zero size, oh well
		fractions[i] = 0.0000001;
		continue;
	}
	var extra = 0.01 - fractions[i];
	if (extra > 0) {
		fractions[i] = 0.01;
		totalExtra += extra;
	}
}
fractions[maxData] -= totalExtra;
]]></method>
            <method name="fetch"><![CDATA[if (index >= fractions.length) {
	return false;
}

row["category"] = index;
row["count"] = fractions[index];

index++;

return true;
]]></method>
        </script-data-set>
        <script-data-set name="policyViolations" id="750">
            <list-property name="resultSetHints">
                <structure>
                    <property name="position">0</property>
                    <property name="name">policyName</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">1</property>
                    <property name="name">threat</property>
                    <property name="dataType">integer</property>
                </structure>
                <structure>
                    <property name="position">2</property>
                    <property name="name">category</property>
                    <property name="dataType">string</property>
                </structure>
                <structure>
                    <property name="position">3</property>
                    <property name="name">actions</property>
                    <property name="dataType">string</property>
                </structure>
            </list-property>
            <list-property name="columnHints">
                <structure>
                    <property name="columnName">policyName</property>
                    <text-property name="displayName">Policy Name</text-property>
                </structure>
                <structure>
                    <property name="columnName">threat</property>
                    <text-property name="displayName">Threat</text-property>
                </structure>
                <structure>
                    <property name="columnName">category</property>
                    <text-property name="displayName">Category</text-property>
                </structure>
                <structure>
                    <property name="columnName">actions</property>
                    <text-property name="displayName">Actions</text-property>
                </structure>
            </list-property>
            <structure name="cachedMetaData">
                <list-property name="resultSet">
                    <structure>
                        <property name="position">1</property>
                        <property name="name">policyName</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">2</property>
                        <property name="name">threat</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">category</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">actions</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">policyViolations</property>
            <method name="open"><![CDATA[index = 0;
]]></method>
            <method name="fetch"><![CDATA[if (index >= policies.size()) {
	return false;
}

var keys = function(obj) {
	var keys = [];
	for(var k in obj) keys.push(k);
	return keys;
};

function determineAction(actions){
	var messages = {};
	for(var i = 0; i < actions.length; i++){
		var action = actions[i];
        switch(action.actionTypeId){
        	case 'fail':
        		messages['Failed'] = true;
        		break;
        	case 'warn':
 	       		messages['Warning'] = true;
        		break;
        	case 'notify':
        		//we don't show this info
        		break;
        }
	}
	return keys(messages).join(', ');
}

var policy = policies.get(index);

row["policyName"] = policy.policyName;
row["threat"] = policy.threatLevel;
row["actions"] = determineAction(policy.actions);

if (policy.threatLevel >= 8) {
	row["category"] = "critical";
} else if (policy.threatLevel >= 4) {
	row["category"] = "severe";
} else if (policy.threatLevel >= 2){
	row["category"] = "moderate";
}
else{
	row["category"] = "ignore";
}
index++;
return true;]]></method>
        </script-data-set>
