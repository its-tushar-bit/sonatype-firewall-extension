{
  "name": "insight-brain-frontend",
  "version": "1.149.0-SNAPSHOT",
  "scripts": {
    "start": "npm-run-all lint esbuild:serve",
    "build": "npm-run-all ci-lint esbuild:build",
    "esbuild:serve": "node esbuild.config.mjs --serve",
    "esbuild:build": "node esbuild.config.mjs --production",
    "test": "npm-run-all jest test-lint typecheck",
    "test-lint": "eslint --ext .jsx,.js src/test/frontend",
    "lint": "npm-run-all lint:eslint lint:stylelint",
    "ci-lint": "npm-run-all ci-lint:eslint ci-lint:stylelint",
    "lint:eslint": "eslint --ext .js,.jsx --ignore-pattern src/main/frontend/lib --ignore-pattern src/main/frontend/version-graph src/main/frontend",
    "ci-lint:eslint": "eslint --ext .js,.jsx --ignore-pattern src/main/frontend/lib --ignore-pattern src/main/frontend/version-graph src/main/frontend --max-warnings=0",
    "lint:stylelint": "stylelint src/**/*.css src/**/*.scss",
    "ci-lint:stylelint": "stylelint src/**/*.css src/**/*.scss --max-warnings=0",
    "jest": "jest",
    "jest-watch": "jest --watch",
    "jest-debug": "node --nolazy --inspect-brk ./node_modules/jest/bin/jest.js --runInBand --colors --verbose",
    "typecheck": "tsc",
    "clean": "rimraf target/generated-resources/webpack/assets",
    "format": "prettier -w",
    "lint:check-nosc-colors": "bash script/check-nosc-no-hardcoded-color.sh"
  },
