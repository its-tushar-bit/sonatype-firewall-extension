            <id>${jasmine.brain.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <preloadSources>
                <source>frontend/lib/jquery/jquery.js</source>
                <source>frontend/lib/bootstrap/bootstrap-2.3.1.min.js</source>
                <source>frontend/lib/angular/angular.js</source>
                <source>frontend/lib/angular-${angularjs.version}/angular-aria.js</source>
                <source>frontend/lib/angular-${angularjs.version}/angular-cookies.js</source>
                <source>frontend/lib/angular-${angularjs.version}/angular-route.js</source>
                <source>frontend/lib/angular-${angularjs.version}/angular-sanitize.js</source>
                <source>frontend/lib/angular-ui-router-0.2.15.min.js</source>
                <source>frontend/lib/angular-ui-utils-0.0.3.js</source>
                <source>frontend/lib/angular-vs-repeat/src/angular-vs-repeat.js</source>
                <source>frontend/lib/ui-bootstrap-tpls-0.13.4.min.js</source>
                <source>frontend/lib/X-editable/xeditable-0.1.8.min.js</source>
                <source>frontend/lib/ngUpload/ng-upload.js</source>
                <source>frontend/lib/d3/d3.js</source>
                <source>frontend/lib/fuse.js/src/fuse.js</source>
                <source>frontend/SpecUtil.js</source>
              </preloadSources>
              <sourceIncludes>
                <include>frontend/**/*.module.js</include>
                <include>frontend/**/*Module.js</include>
                <include>frontend/**/*.js</include>
              </sourceIncludes>
              <sourceExcludes>
                <exclude>frontend/lib/**/*.js</exclude>
                <exclude>frontend/brain-client/*.js</exclude>
                <exclude>frontend/version-graph/*.js</exclude>
                <exclude>frontend/cip/*.js</exclude>
                <exclude>frontend/policy/js/*.js</exclude>
              </sourceExcludes>
              <specIncludes>
                <include>frontend/**/*utils.js</include>
                <include>frontend/**/lib/*.js</include>
                <include>frontend/**/*MockData.js</include>
                <include>frontend/**/*.mock.data.js</include>
                <include>frontend/**/*-spec.js</include>
                <include>frontend/**/*.spec.js</include>
                <include>frontend/**/*Spec.js</include>
              </specIncludes>
              <specExcludes>
                <exclude>frontend/**/cip*.js</exclude>
                <exclude>frontend/**/CIP*.js</exclude>
                <exclude>frontend/brain-client/**/*.js</exclude>
                <exclude>frontend/version-graph/**/*.js</exclude>
              </specExcludes>
              <junitXmlReportFileName>TEST-server-new.xml</junitXmlReportFileName>
            </configuration>
          </execution>
          <execution>
            <id>${jasmine.version.graph.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <sourceIncludes>
                <include>frontend/lib/jquery/jquery.js</include>
                <include>frontend/lib/angular/angular.js</include>
                <include>frontend/lib/angular-${angularjs.version}/angular-route.js</include>
                <include>brain-client/*.js</include>
                <include>wro4j/version-graph/protovis.min.js</include>
                <include>wro4j/version-graph/appcheck.js</include>
                <include>wro4j/version-graph/**/*.module.js</include>
                <include>wro4j/version-graph/**/*.app.js</include>
                <include>wro4j/version-graph/app/*.js</include>
                <include>wro4j/version-graph/version.graph/*.js</include>
                <include>frontend/ComponentDisplayModule.js</include>
              </sourceIncludes>
              <sourceExcludes>
                <exclude>wro4j/cip/**/*.js</exclude>
              </sourceExcludes>
              <specIncludes>
                <include>frontend/**/lib/*.js</include>
                <include>resources/assets/version-graph/VersionGraphSpec.js</include>
              </specIncludes>
            </configuration>
          </execution>
          <execution>
            <id>${jasmine.view.details.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <sourceIncludes>
                <include>frontend/lib/jquery/jquery.js</include>
                <include>frontend/lib/angular/angular.js</include>
                <include>frontend/lib/angular-${angularjs.version}/angular-route.js</include>
                <include>brain-client/*.js</include>
                <include>wro4j/version-graph/viewdetails.js</include>
              </sourceIncludes>
              <specIncludes>
                <include>frontend/**/lib/*.js</include>
                <include>resources/assets/version-graph/ViewDetailsSpec.js</include>
              </specIncludes>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <jasmineTargetDir>${project.build.directory}${file.separator}jasmine-reports</jasmineTargetDir>
          <jsSrcDir>${project.basedir}/src/main</jsSrcDir>
          <jsTestSrcDir>${project.basedir}/src/test</jsTestSrcDir>
          <keepServerAlive>true</keepServerAlive>
          <webDriverClassName>org.openqa.selenium.phantomjs.PhantomJSDriver</webDriverClassName>
          <webDriverCapabilities>
            <capability>
              <name>phantomjs.binary.path</name>
              <value>${phantomjs.binary}</value>
            </capability>
          </webDriverCapabilities>
        </configuration>
      </plugin>
      <plugin>
        <groupId>com.github.timurstrekalov</groupId>
        <artifactId>saga-maven-plugin</artifactId>
        <version>${saga.version}</version>
        <executions>
          <execution>
            <id>jasmine-coverage</id>
            <phase>test</phase>
            <goals>
              <goal>coverage</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <baseDir>http://localhost:${jasmine.serverPort}</baseDir>
          <backgroundJavaScriptTimeout>1000</backgroundJavaScriptTimeout>
          <outputDir>${project.build.directory}/coverage</outputDir>
          <sortBy>file</sortBy>
          <noInstrumentPatterns>
            <pattern>.*/SpecUtil\.js</pattern>
            <pattern>.*/lib/.*\.js</pattern>
            <pattern>.*/.*MockData\.js</pattern>
            <pattern>.*/.*-spec\.js</pattern>
            <pattern>.*/.*Spec\.js</pattern>
          </noInstrumentPatterns>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-shade-plugin</artifactId>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <shadedArtifactAttached>true</shadedArtifactAttached>
              <shadedClassifierName>server</shadedClassifierName>
              <filters>
                <filter>
                  <artifact>*:*</artifact>
                  <excludes>
                    <exclude>META-INF/*.SF</exclude>
                    <exclude>META-INF/*.DSA</exclude>
                    <exclude>META-INF/*.RSA</exclude>
                    <exclude>META-INF/maven/**</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:org.eclipse.sisu.inject</artifact>
                  <excludes>
                    <!-- avoid conflict with same resource from BIRT -->
                    <exclude>plugin.xml</exclude>
                  </excludes>
                </filter>
                <filter>
                  <artifact>*:org.eclipse.birt.runtime</artifact>
                  <includes>
                    <include>*.xml</include>
                    <include>org/eclipse/**</include>
                    <include>javax/**</include>
                  </includes>
                </filter>
              </filters>
              <transformers>
                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                  <mainClass>com.sonatype.insight.brain.service.InsightBrainService</mainClass>
                  <manifestEntries>
                    <!-- Required by BIRT to discover the extensions we have shaded in -->
                    <Bundle-SymbolicName>${project.groupId}.server</Bundle-SymbolicName>
                  </manifestEntries>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/NOTICE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/LICENSE.txt</resource>
                </transformer>
                <transformer implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                  <resource>META-INF/insight/configuration.properties</resource>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.eirslett</groupId>
        <artifactId>frontend-maven-plugin</artifactId>
        <version>1.0</version>
        <executions>
          <execution>
            <id>install-node-and-npm</id>
            <goals>
              <goal>install-node-and-npm</goal>
            </goals>
            <configuration>
              <nodeVersion>${node.version}</nodeVersion>
              <npmVersion>${npm.version}</npmVersion>
            </configuration>
          </execution>
          <execution>
            <id>npm-install</id>
            <goals>
              <goal>npm</goal>
            </goals>
          </execution>
          <execution>
            <id>bower-install</id>
            <goals>
              <goal>bower</goal>
            </goals>
          </execution>
          <execution>
            <id>grunt-build</id>
            <goals>
              <goal>grunt</goal>
            </goals>
            <configuration>
              <srcdir>${basedir}/src/main/frontend</srcdir>
              <arguments>${grunt.task}</arguments>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>ro.isdc.wro4j</groupId>
        <artifactId>wro4j-maven-plugin</artifactId>
        <version>${wro4j.version}</version>
        <executions>
          <execution>
            <id>external-libraries</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <targetGroups>external</targetGroups>
              <jsDestinationFolder>${wro4j.brain.resources}assets/js/</jsDestinationFolder>
            </configuration>
          </execution>
          <execution>
            <id>cip-loader</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <targetGroups>cip-loader</targetGroups>
              <cssDestinationFolder>${wro4j.brain.resources}policy/css/</cssDestinationFolder>
              <jsDestinationFolder>${wro4j.brain.resources}policy/js/</jsDestinationFolder>
            </configuration>
          </execution>
          <execution>
            <id>css-cip</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <targetGroups>cip</targetGroups>
              <cssDestinationFolder>${wro4j.brain.resources}cip/</cssDestinationFolder>
              <jsDestinationFolder>${wro4j.brain.resources}cip/</jsDestinationFolder>
            </configuration>
          </execution>
          <execution>
            <id>version-graph</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <targetGroups>version.graph.app,viewdetails</targetGroups>
              <cssDestinationFolder>${wro4j.brain.resources}version-graph/</cssDestinationFolder>
              <jsDestinationFolder>${wro4j.brain.resources}version-graph/</jsDestinationFolder>
            </configuration>
          </execution>
          <execution>
            <id>audit-report</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>run</goal>
            </goals>
            <configuration>
              <targetGroups>audit-report</targetGroups>
              <cssDestinationFolder>${wro4j.brain.resources}audit-report/</cssDestinationFolder>
              <jsDestinationFolder>${wro4j.brain.resources}audit-report/</jsDestinationFolder>
            </configuration>
          </execution>
        </executions>
        <configuration>
          <minimize>${wro4j.minimize}</minimize>
          <wroFile>${basedir}/wro.xml</wroFile>
          <parallelProcessing>true</parallelProcessing>
          <extraConfigFile>${basedir}/wro.properties</extraConfigFile>
          <wroManagerFactory>ro.isdc.wro.maven.plugin.manager.factory.ConfigurableWroManagerFactory</wroManagerFactory>
          <ignoreMissingResources>false</ignoreMissingResources>
          <contextFolder>${basedir}/src/main/</contextFolder>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>test-jar</goal>
            </goals>
            <configuration>
              <includes>
                <include>**/PortAllocator*</include>
                <include>**/AbstractBrainServiceTest*</include>
                <include>**/InsightMockServerRule*</include>
                <include>**/TestInsightBrainService*</include>
                <include>**/TestInsightBrainServiceRule*</include>
                <include>**/TestCLMServer*</include>
                <include>**/AbstractResourceTest*</include>
                <include>**/TestLicenseFingerprinter*</include>
                <include>**/TestProductLicenseManager*</include>
                <include>**/productlicense/license.lic</include>
                <include>**/SlowMoFilter*</include>
                <include>**/TemporaryEntity*</include>
                <include>**/HttpRequest*</include>
                <include>**/HttpResponse*</include>
              </includes>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.eclipse.m2e</groupId>
          <artifactId>lifecycle-mapping</artifactId>
          <version>1.0.0</version>
          <configuration>
            <lifecycleMappingMetadata>
              <pluginExecutions>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.searls</groupId>
                    <artifactId>jasmine-maven-plugin</artifactId>
                    <versionRange>[1.2.0.0,)</versionRange>
                    <goals>
                      <goal>test</goal>
                      <goal>testResources</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>org.sonatype.plugins</groupId>
                    <artifactId>sisu-maven-plugin</artifactId>
                    <versionRange>[1.0,)</versionRange>
                    <goals>
                      <goal>index</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                    <groupId>com.github.klieber</groupId>
                    <artifactId>phantomjs-maven-plugin</artifactId>
                    <versionRange>[0.1,)</versionRange>
                    <goals>
                      <goal>install</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
                <pluginExecution>
                  <pluginExecutionFilter>
                   <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <versionRange>[0,)</versionRange>
                    <goals>
                      <goal>bower</goal>
                    </goals>
                  </pluginExecutionFilter>
                  <action>
                    <ignore />
                  </action>
                </pluginExecution>
              </pluginExecutions>
            </lifecycleMappingMetadata>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>
    <!--
      To execute just the Jasmine tests run mvn phantomjs:install jasmine:test -P <test profile>
      E.g. mvn phantomjs:install jasmine:test -P test-brain
    -->
    <profile>
      <id>test-cip</id>
      <properties>
        <jasmine.cip.id>default-cli</jasmine.cip.id>
      </properties>
    </profile>
    <profile>
      <id>test-audit</id>
      <properties>
        <jasmine.audit.id>default-cli</jasmine.audit.id>
      </properties>
    </profile>
    <profile>
      <id>test-brain</id>
      <properties>
        <jasmine.brain.id>default-cli</jasmine.brain.id>
      </properties>
    </profile>
    <profile>
      <id>test-version-graph</id>
      <properties>
        <jasmine.version.graph.id>default-cli</jasmine.version.graph.id>
      </properties>
    </profile>
    <profile>
      <id>test-view-details</id>
      <properties>
        <jasmine.view.details.id>default-cli</jasmine.view.details.id>
      </properties>
    </profile>
    <profile>
      <id>m2e</id>
      <activation>
        <property>
          <name>m2e.version</name>
        </property>
      </activation>
      <properties>
        <angular.debug>true</angular.debug>
        <grunt.task>m2e</grunt.task>
        <wro4j.minimize>false</wro4j.minimize>
        <wro4j.brain.resources>${project.build.directory}/classes/assets/</wro4j.brain.resources>
      </properties>
    </profile>
    <profile>
      <id>idea</id>
      <properties>
        <wro4j.minimize>false</wro4j.minimize>
      </properties>
    </profile>
    <profile>
      <id>obfuscate</id>
      <activation>
        <property>
          <name>!skip-obfuscate</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.wvengen</groupId>
            <artifactId>proguard-maven-plugin</artifactId>
            <configuration>
              <injar>${project.build.finalName}-server.jar</injar>
              <includeDependency>false</includeDependency>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>seed-map</id>
                <phase>package</phase>
                <goals>
                  <goal>attach-artifact</goal>
                </goals>
                <configuration>
                  <artifacts>
                    <artifact>
                      <file>${project.build.directory}/proguard_seeds.txt</file>
                      <classifier>seeds</classifier>
                      <type>txt</type>
                    </artifact>
                    <artifact>
                      <file>${project.build.directory}/proguard_map.txt</file>
                      <classifier>map</classifier>
                      <type>txt</type>
                    </artifact>
                  </artifacts>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>test-only-properties</id>
      <activation>
        <property>
          <name>!build.number</name>
        </property>
      </activation>
      <properties>
        <build.number>build-number</build.number>
      </properties>
    </profile>
    <profile>
      <id>clean-node</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>node</directory>
                </fileset>
                <fileset>
                  <directory>node_modules</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
