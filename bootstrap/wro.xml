<groups xmlns="http://www.isdc.ro/wro"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.isdc.ro/wro wro.xsd">

	<group name='Scaffolding'>
		<css>/less/reset.less</css> <!-- Normalize and reset -->
		<css>/less/scaffolding.less</css> <!-- Body type and links -->
		<css>/less/grid.less</css> <!-- Grid system -->
		<css>/less/layouts.less</css> <!-- Layouts -->
	</group>

	<group name='Base_CSS'>
		<css>/less/type.less</css> <!-- Headings, body, etc -->
		<css>/less/code.less</css> <!-- Code and pre -->
		<css>/less/labels-badges.less</css> <!-- Labels and badges -->
		<css>/less/tables.less</css> <!-- Tables -->
		<css>/less/forms.less</css> <!-- Forms -->
		<css>/less/buttons.less</css> <!-- Buttons -->
		<css>/less/sprites.less</css> <!-- Icons -->
	</group>

	<group name='Components'>
		<css>/less/button-groups.less</css> <!-- Button groups and dropdowns -->
		<css>/less/navs.less</css> <!-- Navs, tabs, and pills -->
		<css>/less/navbar.less</css> <!-- Navbar -->
		<css>/less/breadcrumbs.less</css> <!-- Breadcrumbs -->
		<css>/less/pagination.less</css> <!-- Pagination -->
		<css>/less/pager.less</css> <!-- Pager -->
		<css>/less/thumbnails.less</css> <!-- Thumbnails -->
		<css>/less/alerts.less</css> <!-- Alerts --> <!--  Note: alerts share common CSS with buttons and thus have styles in buttons.less -->
		<css>/less/progress-bars.less</css> <!-- Progress bars -->
		<css>/less/hero-unit.less</css> <!-- Hero unit -->
		<css>/less/media.less</css> <!-- Media component -->
	</group>

	<group name='JS_Components'>
		<css>/less/tooltip.less</css> <!-- Tooltips -->
		<css>/less/popovers.less</css> <!-- Popovers -->
		<css>/less/modals.less</css> <!-- Modals -->
		<css>/less/dropdowns.less</css> <!-- Dropdowns -->
		<css>/less/accordion.less</css> <!-- Collapse -->
		<css>/less/carousel.less</css> <!-- Carousel -->
	</group>

	<group name='Miscellaneous'>
		<css>/less/wells.less</css> <!-- Wells -->
		<css>/less/close.less</css> <!-- Close icon -->
		<css>/less/component-animations.less</css> <!-- Component animations -->
	</group>

	<group name='Responsive'>
		<css>/less/responsive-utilities.less</css> <!-- Visible/hidden classes -->
		<css>/less/responsive-767px-max.less</css> <!-- Narrow tablets and below (<767px) -->
		<css>/less/responsive-768px-979px.less</css> <!-- Tablets to desktops (767-979px) -->
		<css>/less/responsive-1200px-min.less</css> <!-- Large desktops (>1200px) -->
		<css>/less/responsive-navbar.less</css> <!-- Responsive navbar -->
	</group>

	<group name='brain'>
		<js>/license.js</js>

		<js>/js/bootstrap-transition.js</js>
		<js>/js/bootstrap-modal.js</js>
		<js>/js/bootstrap-dropdown.js</js>
		<js>/js/bootstrap-tab.js</js>
		<js>/js/bootstrap-tooltip.js</js>
		<js>/js/bootstrap-popover.js</js>
		<js>/js/bootstrap-affix.js</js>
		<js>/js/bootstrap-button.js</js>
		<js>/js/bootstrap-typeahead.js</js>

		<css>/license.css</css>
		<css>/less/variables.less</css> <!--  Modify this for custom colors, font-sizes, etc -->
		<css>/less/mixins.less</css>
		<group-ref>Scaffolding</group-ref>

		<!-- From Base -->
		<css>/less/type.less</css> <!-- Headings, body, etc -->
		<css>/less/tables.less</css> <!-- Tables -->
		<css>/less/forms.less</css> <!-- Forms -->
		<css>/less/buttons.less</css> <!-- Buttons -->
		<css>/less/sprites.less</css> <!-- Icons -->

		<!-- Components -->
		<css>/less/button-groups.less</css> <!-- Button groups and dropdowns -->
		<css>/less/navs.less</css> <!-- Navs, tabs, and pills -->
		<css>/less/navbar.less</css> <!-- Navbar -->
		<css>/less/alerts.less</css> <!-- Alerts --> <!--  Note: alerts share common CSS with buttons and thus have styles in buttons.less -->

		<!-- JS Components -->
		<css>/less/tooltip.less</css> <!-- Tooltips -->
		<css>/less/popovers.less</css> <!-- Popovers -->
		<css>/less/modals.less</css> <!-- Modals -->
		<css>/less/dropdowns.less</css> <!-- Dropdowns -->

		<!-- Misc -->
		<group-ref>Miscellaneous</group-ref>

		<css>/less/utilities.less</css> <!--  Has to be last to override when necessary -->
	</group>
</groups>
