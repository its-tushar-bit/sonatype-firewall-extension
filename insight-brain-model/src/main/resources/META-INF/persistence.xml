<?xml version="1.0" encoding="UTF-8"?>
<persistence version="1.0" xmlns="http://java.sun.com/xml/ns/persistence" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
  <persistence-unit name="InsightBrainODS" transaction-type="RESOURCE_LOCAL">
    <provider>org.apache.openjpa.persistence.PersistenceProviderImpl</provider>
    <class>com.sonatype.insight.brain.model.Application</class>
    <class>com.sonatype.insight.brain.model.label.Label</class>
    <class>com.sonatype.insight.brain.model.label.ComponentLabel</class>
    <properties>
      <!-- 
      <property name="openjpa.ConnectionURL" value="jdbc:hsqldb:tutorial_database"/>
      <property name="openjpa.ConnectionDriverName" value="org.hsqldb.jdbcDriver"/>
      <property name="openjpa.ConnectionUserName" value="sa"/>
      <property name="openjpa.ConnectionPassword" value=""/>
      -->
      <property name="openjpa.Log" value="DefaultLevel=WARN, Tool=INFO"/>
      <!-- To log queries and query parameter values:
      <property name="openjpa.ConnectionFactoryProperties" value="PrintParameters=True"/>      
      <property name="openjpa.Log" value="DefaultLevel=TRACE, Runtime=INFO, Tool=INFO, SQL=TRACE"/>
      -->
    </properties>
  </persistence-unit>
</persistence>
