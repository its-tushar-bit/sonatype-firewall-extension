  <Dimension>Two_Dimensional</Dimension>
  <Script>&#xD;
/**&#xD;
 * Called before rendering the label for each datapoint.&#xD;
 * &#xD;
 * @param dph&#xD;
 *            DataPointHints&#xD;
 * @param label&#xD;
 *            Label&#xD;
 * @param icsc&#xD;
 *            IChartScriptContext&#xD;
 */&#xD;
&#xD;
function beforeDrawDataPointLabel( dph, label, icsc )&#xD;
{&#xD;
	var index = dph.getIndex();&#xD;
	if (dph.getOrthogonalValue() &lt;= 0.001) {&#xD;
		// NOTE: All positive data points have slices >= 1%, anything smaller is a stub slice to avoid crashing on 0 size&#xD;
		label.setVisible(false);&#xD;
	} else if (index == 0) {&#xD;
		label.getCaption().getColor().set(0x9d, 0x0c, 0x11);&#xD;
	} else if (index == 1) {&#xD;
		label.getCaption().getColor().set(0xc6, 0x7a, 0x22);&#xD;
	} else if (index == 2) {&#xD;
		label.getCaption().getColor().set(0x83, 0x74, 0x0d);&#xD;
	} else {&#xD;
		label.setVisible(false);&#xD;
	}&#xD;
}&#xD;
</Script>
