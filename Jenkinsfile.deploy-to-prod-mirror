@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

/**
 * Manual entry point for production releases.
 *
 * This job deploys to prod-mirror and then triggers regional production deployments.
 * This is a MANUAL TRIGGER ONLY job - no automated triggers.
 * An operator must explicitly initiate production releases.
 *
 * Parameters:
 *   IMAGE_TAG - The prod ECR tag to release (must be a prod-internal-verified-* tag)
 *
 * Jenkins job path: insight/MTIQ/sca-cloud/deploy-to-prod-mirror
 *
 */

def PROD_INFRASTRUCTURE_READY = true

// Prod-mirror cell workspace — explicit allowlist
def PROD_MIRROR_CELL_WORKSPACES = ['sca_aws_staging_cell-prod-mirror']
def PROD_MIRROR_GLOBAL_WORKSPACE = 'sca_aws_prod_global'

pipeline {
  agent { label 'zion-small' }

  // NO triggers block - this job is manual trigger only

  parameters {
    string(name: 'IMAGE_TAG',
           description: 'The prod ECR tag to release (must be a prod-internal-verified-* tag, e.g., prod-internal-verified-20260421-1432)')
  }

  options {
    timestamps()
    buildDiscarder(logRotator(numToKeepStr: '100'))
    disableConcurrentBuilds()
    // NOTE: Must be sufficient for mirror deploy + triggering regional jobs
    timeout(time: 30, unit: 'MINUTES')
  }

  stages {

    stage('Validate Parameters') {
      steps {
        script {
          if (!params.IMAGE_TAG?.trim()) {
            error 'IMAGE_TAG parameter is required'
          }
          echo "Production release for image tag: ${params.IMAGE_TAG}"
        }
      }
    }

    stage('Checkout') {
      steps {
        checkout([
          $class: 'GitSCM',
          branches: [[name: '*/main']],
          userRemoteConfigs: [[url: 'git@github.com:sonatype/insight-brain.git', credentialsId: sonatypeZionCredentialsId()]]
        ])
      }
    }

    stage('Validate Image') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would validate image ${params.IMAGE_TAG} exists in prod ECR"
            echo "BYPASS: Would verify image has prod-internal-verified-* tag"
            return
          }

          def ecr = load 'jenkins/ecr-helpers.groovy'

          // Validate image exists in prod ECR
          ecr.validateImageExists(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            params.IMAGE_TAG
          )

          // Safety check: verify image has a prod-internal-verified tag
          withAwsRole(credentialsId: ecr.PROD_ECR_ACCOUNT.credentialId, role: ecr.PROD_ECR_ACCOUNT.role,
                      roleAccount: ecr.PROD_ECR_ACCOUNT.id, region: ecr.ECR_REGION) {
            withEnv(["REPOSITORY_ARG=${ecr.ECR_REPOSITORY}", "IMAGE_TAG_ARG=${params.IMAGE_TAG}", "REGION_ARG=${ecr.ECR_REGION}"]) {
              def imageDetail = sh(script: '''
                aws ecr describe-images \\
                  --repository-name "$REPOSITORY_ARG" \\
                  --image-ids "imageTag=$IMAGE_TAG_ARG" \\
                  --region "$REGION_ARG" \\
                  --query 'imageDetails[0].imageTags' \\
                  --output json
              ''', returnStdout: true).trim()

              def tags = readJSON text: imageDetail
              if (!tags) {
                error "ECR returned no tags for image ${params.IMAGE_TAG} in ${ecr.ECR_REPOSITORY}. " +
                      "Has the image been promoted from staging?"
              }
              def hasVerifiedTag = tags.any { it.startsWith('prod-internal-verified-') }

              if (!hasVerifiedTag) {
                error "Image ${params.IMAGE_TAG} does not have a prod-internal-verified-* tag. " +
                      "Only images that have passed prod-internal validation can be released to production."
              }
              echo "Verified: Image has prod-internal-verified tag"
            }
          }
        }
      }
    }

    stage('Deploy to Prod-Mirror Cell') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "============================================"
            echo "PRODUCTION INFRASTRUCTURE NOT YET READY"
            echo "============================================"
            echo "This job is running in BYPASS mode."
            echo "The production AWS infrastructure is being built by another team."
            echo ""
            echo "Once production infrastructure is available:"
            echo "1. Set PROD_INFRASTRUCTURE_READY = true in this Jenkinsfile"
            echo "2. Update PROD_MIRROR_CELL_WORKSPACES and PROD_MIRROR_GLOBAL_WORKSPACE in this Jenkinsfile"
            echo ""
            echo "Would deploy image tag: ${params.IMAGE_TAG}"
            echo "============================================"
            return
          }

          def tfc = load 'jenkins/tfc-helpers.groovy'
          tfc.deployCells('prod-mirror', PROD_MIRROR_CELL_WORKSPACES, PROD_MIRROR_GLOBAL_WORKSPACE, params.IMAGE_TAG)
        }
      }
    }

    stage('Tag as Production') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would tag image as production-mirror-latest and production-{timestamp}"
            return
          }

          def ecr = load 'jenkins/ecr-helpers.groovy'
          def dateStamp = new Date().format('yyyyMMdd-HHmm', TimeZone.getTimeZone('UTC'))
          def productionTag = "production-${dateStamp}"

          def manifest = ecr.getImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            params.IMAGE_TAG
          )

          ecr.putImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            'production-mirror-latest',
            manifest
          )

          ecr.putImageManifest(
            ecr.PROD_ECR_ACCOUNT,
            ecr.ECR_REPOSITORY,
            productionTag,
            manifest
          )

          echo "Tagged image as: production-mirror-latest, ${productionTag}"
        }
      }
    }

    stage('Trigger Regional Prod Jobs') {
      steps {
        script {
          if (!PROD_INFRASTRUCTURE_READY) {
            echo "BYPASS: Would trigger regional production jobs for ${params.IMAGE_TAG}"
            return
          }

          // Trigger all three regional production jobs in parallel
          parallel([
            'us-1': {
              build job: 'insight/MTIQ/sca-cloud/deploy-to-prod-us-1',
                  parameters: [string(name: 'IMAGE_TAG', value: params.IMAGE_TAG)],
                  wait: false,
                  propagate: false
            },
            'us-2': {
              build job: 'insight/MTIQ/sca-cloud/deploy-to-prod-us-2',
                  parameters: [string(name: 'IMAGE_TAG', value: params.IMAGE_TAG)],
                  wait: false,
                  propagate: false
            },
            'eu-1': {
              build job: 'insight/MTIQ/sca-cloud/deploy-to-prod-eu-1',
                  parameters: [string(name: 'IMAGE_TAG', value: params.IMAGE_TAG)],
                  wait: false,
                  propagate: false
            }
          ])
        }
      }
    }
  }

  post {
    success {
      script {
        def status = PROD_INFRASTRUCTURE_READY ? "Production release initiated" : "Acknowledged (bypass mode)"
        echo "deploy-to-prod-mirror: ${status} for ${params.IMAGE_TAG}"

        // TODO: Enable when real production is ready
        // notifyChat(currentBuild: currentBuild, env: env, room: 'mtiq-notices',
        //            message: "Production release initiated: ${params.IMAGE_TAG}")
      }
    }
    failure {
      script {
        echo "deploy-to-prod-mirror: FAILED for ${params.IMAGE_TAG}"

        // Provide rollback instructions
        echo "============================================"
        echo "ROLLBACK INSTRUCTIONS"
        echo "============================================"
        echo "1. Identify the previous known-good image tag from prod ECR"
        echo "2. Re-run this job with the previous tag, or"
        echo "3. Manually update the TFC workspace variable and apply"
        echo "============================================"

        // TODO: Enable when real production is ready
        // notifyChat(currentBuild: currentBuild, env: env, room: 'mtiq-notices',
        //            message: "Production release FAILED: ${params.IMAGE_TAG}. Check logs for rollback instructions.")
      }
    }
    cleanup {
      sh 'rm -f image-manifest.json || true'
      deleteDir()
    }
  }
}
