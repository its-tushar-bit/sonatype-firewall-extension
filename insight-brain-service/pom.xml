      </properties>
    </profile>
    <profile>
      <id>m2e-ui-dev</id>
      <properties>
        <!-- As obfuscate profile is default enabled the frontend plugin uses the grunt obfuscate task -->
        <grunt.task.obfuscate>m2e-ui-dev</grunt.task.obfuscate>
      </properties>
    </profile>
    <profile>
      <id>idea</id>
      <properties>
      </properties>
    </profile>
    <profile>
      <id>obfuscate</id>
      <activation>
        <property>
          <name>!skip-obfuscate</name>
        </property>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>com.github.eirslett</groupId>
            <artifactId>frontend-maven-plugin</artifactId>
            <version>1.0</version>
            <executions>
              <execution>
                <id>grunt-build</id>
                <goals>
                  <goal>grunt</goal>
                </goals>
                <configuration>
                  <srcdir>${basedir}/src/main/frontend</srcdir>
                  <arguments>${grunt.task.obfuscate}</arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
    <profile>
      <id>test-only-properties</id>
      <activation>
        <property>
          <name>!build.number</name>
        </property>
      </activation>
      <properties>
        <build.number>build-number</build.number>
      </properties>
    </profile>
    <profile>
      <id>clean-node</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-clean-plugin</artifactId>
            <configuration>
              <filesets>
                <fileset>
                  <directory>node</directory>
                </fileset>
                <fileset>
                  <directory>node_modules</directory>
                </fileset>
              </filesets>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
