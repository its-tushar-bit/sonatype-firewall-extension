@Library(['private-pipeline-library', 'jenkins-shared']) _

def imageId = "cdi-run:${env.BUILD_NUMBER}${currentBuild.startTimeInMillis}"

// we can't safely get the branch name from Jenkins environment, particularly since this isn't a multibranch pipeline
def branch = 'master'

pipeline {
    agent { label 'insight-build-agent' }
    triggers {
        // runs at ~midnight every Sunday
        cron('@weekly')
    }
    stages {
        stage('Prepare Image') {
            steps {
                sh "docker build -t ${imageId} .insight"
            }
        }
        stage('Run') {
          steps {
            withDockerImage(imageId, {
              sh 'python3 .insight/rotate_reviewers.py'
            })
          }
        }
        stage('Commit and Push README') {
          steps {
            sh "git config user.email 'sonatype-zion@sonatype.com'"
            sh "git config user.name 'Sonatype Zion'"
            sh 'git add readme.md'
            sh 'git commit -m "Rotate Reviewers"'

            sshagent(credentials: [sonatypeZionCredentialsId()]) {
              sh "git push origin ${branch}"
            }
          }
        }
    }
    post {
      cleanup {
        dockerRemoveImages()
        deleteDir()
      }
    }
}
