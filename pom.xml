<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonatype.buildsupport</groupId>
    <artifactId>private-parent</artifactId>
    <version>5</version>
    <relativePath />
  </parent>

  <groupId>com.sonatype.insight.brain</groupId>
  <artifactId>insight-brain</artifactId>
  <version>1.7.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>Insight Brain Parent POM</name>

  <properties>
    <maven.compiler.source>1.7</maven.compiler.source>
    <maven.compiler.target>1.7</maven.compiler.target>
    <build.number /> <!-- Generated by CI/release build. -->
    <insight-scanner.version>2.0.9-01</insight-scanner.version>
    <insight-saas.version>2.0.6-SNAPSHOT</insight-saas.version>
    <slf4j.version>1.7.5</slf4j.version>
    <logback.version>1.0.12</logback.version>
    <jackson.version>2.1.2</jackson.version>
    <openjpa.version>2.2.2</openjpa.version>
    <shiro.version>1.2.2</shiro.version>
    <sisu-inject.version>2.3.4</sisu-inject.version>
    <sisu-guice.version>3.1.3</sisu-guice.version>
    <clm.model.version>1.4</clm.model.version>
    <dropwizard.version>0.6.2</dropwizard.version>
    <!-- The jersey.version must match the the jersey version used by dropwizard -->
    <jersey.version>1.17.1</jersey.version>
  </properties>

  <scm>
    <connection>scm:git:git@github.com/sonatype/insight-brain.git</connection>
    <developerConnection>scm:git:ssh://git@github.com/sonatype/insight-brain.git</developerConnection>
    <url>http://github.com/sonatype/insight-brain</url>
  </scm>

  <modules>
    <module>insight-json-store</module>
    <module>insight-brain-model</module>
    <module>insight-brain-policy-model</module>
    <module>insight-brain-db</module>
    <module>insight-brain-data-access</module>
    <module>insight-brain-policy-data-access</module>
    <module>insight-brain-ldap</module>
    <module>insight-brain-service</module>
    <module>insight-brain-client</module>
    <module>insight-rm-common</module>
    <module>insight-brain-functional-test</module>
    <module>sonatype-clm-server</module>
    <module>sonatype-clm-scanner</module>
  </modules>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-client</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-data-access</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-db</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-model</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-policy-data-access</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-policy-model</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-service</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-service</artifactId>
        <version>1.7.0-SNAPSHOT</version>
        <classifier>tests</classifier>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-json-store</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-ldap</artifactId>
        <version>1.7.0-SNAPSHOT</version>
      </dependency>
      <dependency>
        <groupId>com.sonatype.insight.brain</groupId>
        <artifactId>insight-brain-ldap</artifactId>
        <version>1.7.0-SNAPSHOT</version>
        <classifier>tests</classifier>
        <scope>test</scope>
      </dependency>
      <dependency>
        <groupId>org.apache.directory.server</groupId>
        <artifactId>apacheds-core-integ</artifactId>
        <version>2.0.0-M13</version>
        <exclusions>
          <exclusion>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-log4j12</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.apache.directory.server</groupId>
            <artifactId>apacheds-jdbm-partition</artifactId>
          </exclusion>
          <exclusion>
            <groupId>org.apache.directory.jdbm</groupId>
            <artifactId>apacheds-jdbm1</artifactId>
          </exclusion>
        </exclusions>
        <scope>test</scope>
      </dependency>

      <dependency>
        <groupId>com.sonatype.clm</groupId>
        <artifactId>com.sonatype.clm.dto.model</artifactId>
        <version>${clm.model.version}</version>
      </dependency>

      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>slf4j-api</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>org.slf4j</groupId>
        <artifactId>jcl-over-slf4j</artifactId>
        <version>${slf4j.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-classic</artifactId>
        <version>${logback.version}</version>
      </dependency>
      <dependency>
        <groupId>ch.qos.logback</groupId>
        <artifactId>logback-core</artifactId>
        <version>${logback.version}</version>
      </dependency>

      <dependency>
        <groupId>javax.inject</groupId>
        <artifactId>javax.inject</artifactId>
        <version>1</version>
        <scope>provided</scope>
      </dependency>
      <dependency>
        <groupId>org.sonatype.sisu</groupId>
        <artifactId>sisu-guice</artifactId>
        <version>${sisu-guice.version}</version>
      </dependency>
      <dependency>
        <groupId>org.sonatype.sisu</groupId>
        <artifactId>sisu-guice</artifactId>
        <version>${sisu-guice.version}</version>
        <classifier>no_aop</classifier>
      </dependency>
      <dependency>
        <groupId>org.sonatype.sisu.inject</groupId>
        <artifactId>guice-multibindings</artifactId>
        <version>${sisu-guice.version}</version>
      </dependency>
      <dependency>
        <groupId>org.sonatype.sisu</groupId>
        <artifactId>sisu-inject-bean</artifactId>
