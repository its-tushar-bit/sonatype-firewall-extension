    <data-sources>
        <script-data-source name="bom" id="18">
            <method name="open"><![CDATA[var json = Packages.org.codehaus.plexus.util.FileUtils.fileRead(new java.io.File(params["reportDir"].value, "bom.json"), "UTF-8");
bom = eval("(" + json + ")").aaData;

json = Packages.org.codehaus.plexus.util.FileUtils.fileRead(new java.io.File(params["reportDir"].value, "licenses.json"), "UTF-8");
var licenses = eval("(" + json + ")").aaData, licMap = {};
for (var i = 0; i < licenses.length; i++) {
	var componentKey = getComponentKey(licenses[i]);
	licMap[componentKey] = licenses[i];
}

var policyAlertsFile = new java.io.File(params["reportDir"].value, "policyalerts.json");
if(policyAlertsFile.exists()){
	json = Packages.org.codehaus.plexus.util.FileUtils.fileRead(policyAlertsFile, "UTF-8");
} else {
	//assume the location of the required file relative to the reportDir
	json = Packages.org.codehaus.plexus.util.FileUtils.fileRead(new java.io.File(params["reportDir"].value, "/../report.cache/policyalerts.json"), "UTF-8");
}

var policyViolations = eval("(" + json + ")").aaData, hashViolationMap = {};

function determineComponentPolicyViolations(policyViolation){
	for(var i = 0; i< policyViolation.componentFacts.length; i++){
		var componentFact = policyViolation.componentFacts[i];
		var hash = componentFact.hash;
		if(hashViolationMap[hash] == null){
			hashViolationMap[hash] = [0, 0, 0, 0];
		}
		if (policyViolation.threatLevel >= 8) {
			hashViolationMap[hash][0] += 1;	
		} else if (policyViolation.threatLevel >= 4) {
			hashViolationMap[hash][1] += 1;	
		} else if (policyViolation.threatLevel >= 2){
			hashViolationMap[hash][2] += 1;	
		}
		else{
			hashViolationMap[hash][3] += 1;	
		}
	}
}

for(var i = 0; i< policyViolations.length; i++){
	determineComponentPolicyViolations(policyViolations[i].trigger);
}
		
for (var i = 0; i < bom.length; i++) {
	bom[i].declaredLicenses = ["Not Provided"];
	bom[i].observedLicenses = ["Not Provided"];
	bom[i].effectiveLicenseThreat = "NOT-PROVIDED";
	bom[i].svCount = 0;
	if(hashViolationMap[bom[i].hash]){
		bom[i].policyViolationCounts = hashViolationMap[bom[i].hash];
	}
	else{
		bom[i].policyViolationCounts = [0,0,0,0];
	}

	if (bom[i].matchState != 'unknown') {
		var componentKey = getComponentKey(bom[i]);
		var lic = licMap[componentKey];
		if (lic) {
			if (lic.overriddenLicenses) {
				bom[i].declaredLicenses = lic.overriddenLicenses;
				bom[i].observedLicenses = [];
				bom[i].effectiveLicenseThreat = lic.overriddenLicenseThreat;
			} else {
				var dedup = [];
				for (var j = 0; j < lic.observedLicenses.length; j++) {
					if ("Not Provided" === lic.observedLicenses[j] || lic.declaredLicenses.indexOf(lic.observedLicenses[j]) < 0) {
						dedup.push(lic.observedLicenses[j]);
					}
				}
				bom[i].declaredLicenses = lic.declaredLicenses;
				bom[i].observedLicenses = dedup;
				
				// Deprecated as of Insight-Brain 1.2. Leave in for compatibility with Insight-Brain 1.1
				if (isNaN(lic.effectiveLicenseThreat)) {
					if (lic.effectiveLicenseThreat === "COPYLEFT") {
						bom[i].effectiveLicenseThreat = 10;
					} else if (lic.effectiveLicenseThreat === "NON-STANDARD") {
						bom[i].effectiveLicenseThreat = 7;
					} else if (lic.effectiveLicenseThreat === "NOT-PROVIDED") {
						bom[i].effectiveLicenseThreat = 6;
					} else if (lic.effectiveLicenseThreat === "WEAKCOPYLEFT") {
						bom[i].effectiveLicenseThreat = 3;
					} else if (lic.effectiveLicenseThreat === "LIBERAL") {
						bom[i].effectiveLicenseThreat = 0;
					} else {
						bom[i].effectiveLicenseThreat = null;
					}
				} else {
					bom[i].effectiveLicenseThreat = lic.effectiveLicenseThreat;
				}
			}
			if (lic.securityThreatLevel != null) {
				bom[i].svLevel = lic.securityThreatLevel;
			}
			bom[i].svCount = 0;
			for (var c in lic.securityCounters) {
				bom[i].svCount += lic.securityCounters[c];
			}
		}
		else if (bom[i].identificationSource === "Manual") {
			bom[i].declaredLicenses = ["Unavailable, claimed component"];
			bom[i].observedLicenses = [];
		}
	}
}
]]></method>
            <method name="close"><![CDATA[bom = null;
]]></method>
        </script-data-source>
        <script-data-source name="licenses" id="48">
            <method name="open"><![CDATA[var path = new java.io.File(params["reportDir"].value, "licenses.json");
var json = Packages.org.codehaus.plexus.util.FileUtils.fileRead(path, "UTF-8");
licenses = eval("(" + json + ")").aaData;

// Deprecated as of Insight-Brain 1.2. Leave in for compatibility with Insight-Brain 1.1
for (var i = 0; i < licenses.length; i++) {
	var lic = licenses[i];
	if (isNaN(lic.effectiveLicenseThreat)) {
		if (lic.effectiveLicenseThreat === "COPYLEFT") {
			lic.effectiveLicenseThreat = 10;
		} else if (lic.effectiveLicenseThreat === "NON-STANDARD") {
			lic.effectiveLicenseThreat = 7;
		} else if (lic.effectiveLicenseThreat === "NOT-PROVIDED") {
			lic.effectiveLicenseThreat = 6;
		} else if (lic.effectiveLicenseThreat === "WEAKCOPYLEFT") {
			lic.effectiveLicenseThreat = 3;
		} else if (lic.effectiveLicenseThreat === "LIBERAL") {
			lic.effectiveLicenseThreat = 0;
		} else {
			lic.effectiveLicenseThreat = null;
		}
	}
}]]></method>
