@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties([
    parameters([
      booleanParam(defaultValue: true, name: 'CLM'),
      booleanParam(defaultValue: true, name: 'INT'),
      booleanParam(defaultValue: true, name: 'FIRE'),
    ])
])

pipeline {
  agent { label 'zion-small' }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Replace JIRA Fix Version') {
      steps {
        script {
          List<String> issues = []
          if (params.CLM) {
            issues.addAll(getIssuesByFixVersion('CLM', 'brain-next'))
          }
          if (params.INT) {
            issues.addAll(getIssuesByFixVersion('INT', 'brain-next'))
          }
          if (params.FIRE) {
            issues.addAll(getIssuesByFixVersion('FIRE', 'brain-next'))
          }
          replaceFixVersionForIssues(issues, 'brain-next', ['saas-next', 'selfhosted-next'])
        }
      }
    }
  }
}
