                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">problemCode</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">url</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">category</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">status</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">format</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">8</property>
                        <property name="name">displayName</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">security</property>
            <method name="open"><![CDATA[index = 0;
]]></method>
            <method name="fetch"><![CDATA[if (index >= security.length) {
	return false;
}

var sv = security[index];

if (sv.score != null) {
	row["score"] = Math.floor(sv.score);
	row["threat"] = row["score"];
} else {
	row["threat"] = "Unscored";
}
if (sv.score >= 7) {
	row["category"] = "critical";
} else if (sv.score >= 4) {
	row["category"] = "severe";
} else {
	row["category"] = "moderate";
}
row["status"] = sv.status ? sv.status : "Open";
row["problemCode"] = sv.reference;
row["url"] = sv.url;
row["displayName"] = getDisplayName(sv);
row["format"] = getFormat(sv);

index++;

return true;
]]></method>
        </script-data-set>
