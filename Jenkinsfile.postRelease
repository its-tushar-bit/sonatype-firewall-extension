@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

properties([
    parameters([
      string(name: 'releaseVersion', defaultValue: '',description: 'The version number for the product, like "1.118.0-01"'),
    ])
])

pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  options {
    buildDiscarder(logRotator(numToKeepStr: '10'))
  }
  stages {
    stage('Update IQ Server Test Instance') {
      steps {
        script {
          String fullImage = "${sonatypeDockerRegistryId()}/sonatype/nexus-iq-server:${params.releaseVersion}"
          String targetImage = "${sonatypeDockerRegistryId()}/iq/staging:${params.releaseVersion}"

         build('job': 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/staging',
          parameters: [
            string(name: 'BASE_IMAGE', value: fullImage),
            string(name: 'TARGET_IMAGE', value: targetImage),
          ],
          propagate: true)


          build('job': 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/staging',
                    parameters: [
                      string(name: 'environment', value: 'Staging'),
                      string(name:'imageUrl', value: targetImage)
                    ],
                    propagate: true
          )
        }
      }
    }
    stage('Update IQ Server Production Instance') {
      steps {
        script {
          String fullImage = "${sonatypeDockerRegistryId()}/sonatype/nexus-iq-server:${params.releaseVersion}"
          String targetImage = "${sonatypeDockerRegistryId()}/iq/prod:${params.releaseVersion}"

          build('job': 'ops/sonatype-lifecycle/docker-ops-nexus-iq-server/production',
            parameters: [
              string(name: 'BASE_IMAGE', value: fullImage),
              string(name: 'TARGET_IMAGE', value: targetImage),
            ],
            propagate: true)

          build('job': 'ops/sonatype-lifecycle/ops-terraform-ecs-iq-server/production',
                    parameters: [
                      string(name: 'environment', value: 'Production'),
                      string(name:'imageUrl', value: targetImage)
                    ],
                    propagate: true
          )
        }
      }
    }
    stage('Publish IQ Server Helm Chart') {
      steps {
        build(
          job: 'integrations/cloud/Helm3 Charts/Main Release Build',
          parameters: [
            string(name: 'chart', value: 'nexus-iq-server'),
            string(name: 'appVersion', value: params.releaseVersion.replaceAll(/-.*/, '')),
          ]
        )
      }
    }
    stage('Create Post IQ Release Integrations Team Jira Issues') {
      steps {
        createIntegrationIssuesAfterIQRelease(params.releaseVersion)
      }
    }
  }
}

