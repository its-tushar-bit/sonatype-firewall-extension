<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>com.sonatype.insight.brain</groupId>
    <artifactId>insight-brain</artifactId>
    <version>1.207.0-SNAPSHOT</version>
    <!-- Required when this folder is opened alone so Maven / Java LS resolve the reactor and dependencyManagement. -->
    <relativePath>../pom.xml</relativePath>
  </parent>
  <artifactId>insight-brain-variant-test-h2</artifactId>

  <description>
    IQ-on-H2 deployment-variant integration tests. The @IqH2Test meta-annotation boots the proven
    TestCLMServer launcher against an embedded H2 database and reuses that running server across all
    of this module's tests (a single DB fixture type per JVM), hitting the ui/links/* endpoints.
    Split from the Postgres variant (insight-brain-variant-test-pg) so each module uses exactly one
    DatabaseContainerRule fixture type and can safely reuse forks. Run with:
    mvn verify -pl insight-brain-variant-test-h2 -Dskip-functional-test
  </description>

  <properties>
    <clm.skip>true</clm.skip>
  </properties>

  <build>
    <plugins>
      <!-- Tests run under Failsafe (integration-test/verify), mirroring nexus-mtiq-server. -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <includes>
            <include>**/*SpikeTest.*</include>
            <!-- All converted variant tests (Resource/V2/Filter/Servlet/Service/updater/etc.). -->
            <include>**/*Test.*</include>
          </includes>
          <!-- QUARANTINED: converted but need runtime-config/auth fixtures the shared-server harness does not provide
               (SAML message signing, API access-control-list, reverse-proxy baseUrl). Escalate lane. -->
          <excludes>
            <exclude>**/IqH2SamlAuthcTest.*</exclude>
            <exclude>**/IqH2ApiAccessControlFilterTest.*</exclude>
            <exclude>**/IqH2IndexCacheControlFilterTest.*</exclude>
            <!-- Passes in isolation but testRedirection/testDownloadBundle_v3 fail under the reused server
                 due to cross-class global-state leakage (reverse-proxy baseUrl / bundle state). -->
            <exclude>**/report/ReportResourceTest.*</exclude>
          </excludes>
          <trimStackTrace>false</trimStackTrace>
          <!--
            Single DB fixture type (H2) per module, so reuseForks=true is safe: all test classes run
            in one JVM and share the one booted TestCLMServer (cached by AbstractSpikeServerExtension),
            amortizing the ~9s server boot across the whole module. The IQ-H2 / IQ-Postgres
            DatabaseContainerRule singleton collision is avoided by keeping the fixtures in separate
            modules (insight-brain-variant-test-h2 vs -pg) rather than separate forks.
          -->
          <reuseForks>true</reuseForks>
          <forkCount>1</forkCount>
          <forkedProcessTimeoutInSeconds>900</forkedProcessTimeoutInSeconds>
          <forkedProcessExitTimeoutInSeconds>30</forkedProcessExitTimeoutInSeconds>
          <shutdown>kill</shutdown>
          <!--
            Inline add-opens (Spring Boot 4 on JDK 25 needs these) plus a byte-buddy agent for Mockito.
            No @{argLine}: this module is excluded from JaCoCo coverage.
          -->
          <argLine>
            --add-opens=java.base/java.lang=ALL-UNNAMED
            --add-opens=java.base/java.util=ALL-UNNAMED
            --add-opens=java.base/java.security=ALL-UNNAMED
            --add-opens=java.base/sun.security.rsa=ALL-UNNAMED
            --add-opens=java.base/sun.security.x509=ALL-UNNAMED
            --add-opens=java.base/sun.security.util=ALL-UNNAMED
            --add-opens=java.xml/com.sun.org.apache.xerces.internal.jaxp.datatype=ALL-UNNAMED
            --add-opens=java.base/java.util.concurrent=ALL-UNNAMED
            -Xmx3072M
            -javaagent:${settings.localRepository}/net/bytebuddy/byte-buddy-agent/${byte-buddy.version}/byte-buddy-agent-${byte-buddy.version}.jar
            -XX:+HeapDumpOnOutOfMemoryError
            -XX:HeapDumpPath=${project.build.directory}/
          </argLine>
          <systemPropertyVariables>
            <!-- Used by the test IQ server to set a per-fork work directory. -->
            <test.forkId>#${surefire.forkNumber}</test.forkId>
            <!--
              The MTIQ bean graph eagerly builds an AWS SecretsManager client; it needs a region to
              construct (it is never actually called by the ui/links endpoints). CI provides
              AWS_REGION; this shim provides one for local runs.
            -->
            <aws.region>us-east-1</aws.region>
          </systemPropertyVariables>
          <!--
            Drools/kie must stay on the classpath here: unlike the shaded nexus-mtiq-server bundle,
            this module depends on the plain insight-brain-service, and the converted resource tests
            (IqH2IdeResourceTest) exercise real Drools policy evaluation.
          -->
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- No artifacts to deploy: this module only runs tests. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <!-- JUnit 5 (Jupiter) engine + Vintage engine on the JUnit Platform, mirroring nexus-mtiq-server. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <groupId>org.junit.vintage</groupId>
          <artifactId>junit-vintage-engine</artifactId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- @ParameterizedTest/@MethodSource, used by IqH2ReverseProxyAuthcTest. -->
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter-params</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.mockito</groupId>
      <artifactId>mockito-core</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Shared variant-test machinery (AbstractSpikeServerExtension, SpikeRestClient, SpikeSupport). -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-variant-test-support</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>

    <!-- IQ app under test + its test fixtures (TestCLMServer, DatabaseContainerRule, factories, ...). -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-service</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-service</artifactId>
      <classifier>tests</classifier>
      <scope>test</scope>
    </dependency>

    <!-- DB/data/common test fixtures (DatabaseRuleAnnotations, H2DiskDatabaseFixture, ...). -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-db</artifactId>
      <type>test-jar</type>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-data</artifactId>
      <type>test-jar</type>
    </dependency>
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-common</artifactId>
      <type>test-jar</type>
    </dependency>

    <!-- SpringTestExecutionContext lives here. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>insight-brain-test</artifactId>
    </dependency>

    <!-- HDS mock the launcher wires up. -->
    <dependency>
      <groupId>com.sonatype.insight.brain</groupId>
      <artifactId>hds-mock-server</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- Byte Buddy agent for Mockito (referenced by the failsafe -javaagent). -->
    <dependency>
      <groupId>net.bytebuddy</groupId>
      <artifactId>byte-buddy-agent</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- ApacheDS runtime for EmbeddedLdapServer (LDAP-backed auth tests: UserToken/ApiUserToken). -->
    <dependency>
      <groupId>org.apache.directory.server</groupId>
      <artifactId>apacheds-core-integ</artifactId>
      <scope>test</scope>
    </dependency>

    <!-- WireMock for tests that stub external HTTP (e.g. ApiSourceControlResourceTest rate-limit probes). -->
    <dependency>
      <groupId>com.github.tomakehurst</groupId>
      <artifactId>wiremock-jre8-standalone</artifactId>
      <scope>test</scope>
    </dependency>

    <!--
      Legacy javax.xml.bind (JAXB 2.x) runtime impl. The Crowd client and CrowdMockServerRule marshal via
      javax.xml.bind.JAXBContext, whose ContextFinder needs a javax-namespace provider. The module otherwise
      only resolves the jakarta-namespace impl (glassfish jaxb-runtime 4.x), leaving javax JAXB with no
      provider (JAXBContext.newInstance returns null -> NPE). Mirrors insight-brain-service's runtime dep.
    -->
    <dependency>
      <groupId>com.sun.xml.bind</groupId>
      <artifactId>jaxb-impl</artifactId>
      <version>2.3.9</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

</project>
