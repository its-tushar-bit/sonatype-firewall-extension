{
  "parserOptions": {
    "ecmaVersion": 6,
    "sourceType": "module"
  },
  "env": {
    "browser": true,
    "node": true
  },
  "globals": {
    "angular": false,
    "$": false,
    "clmBuildTimestamp": false,
    "Fuse": false,
    "AngularStateUtils":  false
  },
  "extends": "eslint:recommended",
  "rules": {
    "camelcase": [
      2,
      {
        "properties": "never"
      }
    ],
    "curly": [
      2,
      "all"
    ],
    "eqeqeq": 2,
    "wrap-iife": 2,
    "indent": [
      "error",
      2,
      {
        "SwitchCase": 1,
        "MemberExpression": 2,
        "ObjectExpression": 1,
        "VariableDeclarator": 2,
        "FunctionDeclaration": {"parameters": "first"},
        "FunctionExpression": {"parameters": "first"},
        "CallExpression": {"arguments": 2}
      }
    ],
    "new-cap": 0,
    "no-caller": 2,
    "quotes": [
      2,
      "single"
    ],
    "no-undef": 2,
    "no-unused-vars": 2,
    "strict": 2,
    "no-invalid-this": "off", // enable this (See CLM-8375)
    "no-mixed-spaces-and-tabs": 2,
    "no-multiple-empty-lines": 2,
    "no-multi-spaces": 2,
    "no-nested-ternary": "off", // enable this (See CLM-8375)
    "padded-blocks": "off",
    "key-spacing": 2,
    "space-unary-ops": [
      2,
      {
        "words": false,
        "nonwords": false
      }
    ],
    "comma-spacing": [
      2,
      {
        "before": false,
        "after": true
      }
    ],
    "semi-spacing": [
      2,
      {
        "before": false,
        "after": true
      }
    ],
    "no-spaced-func": 2,
    "space-before-function-paren": [
      2,
      {
        "anonymous": "ignore",
        "named": "never"
      }
    ],
    "comma-dangle": [
      2,
      "never"
    ],
    "no-trailing-spaces": 2,
    "eol-last": 2,
    "semi": [
      2,
      "always"
    ],
    "space-infix-ops": 2,
    "keyword-spacing": [
      2,
      {}
    ],
    "space-before-blocks": [
      2,
      "always"
    ],
    "vars-on-top": 0,
    "space-in-parens": [
      2,
      "never"
    ],
    "no-console": [2, { "allow": ["warn", "error"] }],
    "array-bracket-spacing": [2, "never"],
    "object-property-newline": [2, { "allowMultiplePropertiesPerLine": true }]
  }
}
