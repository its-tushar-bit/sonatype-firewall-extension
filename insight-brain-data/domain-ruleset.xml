<ruleset name="insight-brain ruleset"
    xmlns="http://pmd.sourceforge.net/ruleset/2.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://pmd.sourceforge.net/ruleset/2.0.0 http://pmd.sourceforge.net/ruleset_2_0_0.xsd">
  <description>PMD ruleset for insight-brain domain models</description>

  <include-pattern>.*/com/sonatype/insight/brain/model/.*</include-pattern>

  <rule ref="pmd-ruleset/ruleset.xml">

    <!--
         When a domain model has a computed field that is only used in SQL WHERE clauses, and never retrieved,
         it triggers this rule
    -->
    <exclude name="UnusedPrivateField"/>
  </rule>
</ruleset>
