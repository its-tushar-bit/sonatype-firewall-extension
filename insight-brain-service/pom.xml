  <build>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <directory>${project.build.directory}/generated</directory>
      </resource>
      <resource>
        <directory>src/main/filtered-resources</directory>
        <filtering>true</filtering>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/policy/js/</targetPath>
      </resource>
      <resource>
        <directory>src/main/brain-client</directory>
        <filtering>true</filtering>
        <targetPath>${project.build.outputDirectory}/assets/assets/js/</targetPath>
      </resource>
    </resources>
    <plugins>
      <!-- We run the tests using maven-failsafe-plugin because we want to run them
           after the obfuscation was done and to use the artifact jar, not the classes. 
           (The obfuscation may break things in unexpected ways.)  -->
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <configuration>
          <includes>
            <include>**/*Test.*</include>
          </includes>
          <trimStackTrace>false</trimStackTrace>
          <reuseForks>true</reuseForks>
          <forkedProcessTimeoutInSeconds>0</forkedProcessTimeoutInSeconds>
          <!-- Exclude the dependencies we obfuscate in order to ensure the un-obfuscated code is not available. -->
          <classpathDependencyExcludes>
            <classpathDependencyExcludes>com.sonatype.insight.scan:insight-scanner-hashing</classpathDependencyExcludes>
            <classpathDependencyExcludes>org.ow2.asm:asm*</classpathDependencyExcludes>
          </classpathDependencyExcludes>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.sonatype.plugins</groupId>
        <artifactId>sisu-maven-plugin</artifactId>
        <!-- Use 1.1 because: https://github.com/sonatype/insight-brain/commit/63133339 -->
        <version>1.1</version><!--$NO-MVN-MAN-VER$-->
        <executions>
          <execution>
            <id>index-service</id>
            <phase>process-classes</phase>
            <goals>
              <goal>index</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>com.github.klieber</groupId>
        <artifactId>phantomjs-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>com.github.searls</groupId>
        <artifactId>jasmine-maven-plugin</artifactId>
        <version>${jasmine.version}</version>
        <extensions>true</extensions>
        <!-- Only the last execution of this plugin is subject to collection of coverage information, unfortunately. -->
        <executions>
          <execution>
            <id>${jasmine.cip.id}</id>
            <phase>test</phase>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <preloadSources>
                <source>resources/assets/cip/cip-test-util.js</source>
                <include>node_modules/jquery/dist/jquery.js</include>
                <source>root/target/classes/assets/policy/js/cip-loader.js</source>
                <source>node_modules/es6-collections/es6-collections.js</source>
                <source>${basedir}/node_modules/angular-mocks/angular-mocks.js</source>
              </preloadSources>
              <sourceIncludes>
                <include>brain-client/*.js</include>
              </sourceIncludes>
              <sourceExcludes>
                <exclude>frontend/lib/bootstrap-sass-official/**/*.js</exclude>
              </sourceExcludes>
              <specIncludes>
                <include>frontend/SpecUtil.js</include>
                <include>frontend/**/lib/*.js</include>
                <include>frontend/**/*MockData.js</include>
