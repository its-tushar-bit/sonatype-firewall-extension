<assembly>
  <id>bundle</id>
  <baseDirectory>${project.artifactId}-${project.version}-bundle</baseDirectory>
  <includeBaseDirectory>false</includeBaseDirectory>
  <formats>
    <format>zip</format>
    <format>tar.gz</format>
  </formats>
  <fileSets>
    <fileSet>
      <directory>src/main/resources</directory>
      <outputDirectory>.</outputDirectory>
      <excludes>
        <exclude>ASSEMBLY-README.txt</exclude>
        <exclude>sonatype-iq-server</exclude>
        <exclude>sonatype-iq-server.service</exclude>
      </excludes>
    </fileSet>
    <fileSet>
      <directory>src/main/filtered-resources</directory>
      <outputDirectory>.</outputDirectory>
      <filtered>true</filtered>
      <!-- Exclude demo.sh as it will need to have its executable bit set. -->
      <excludes>
        <exclude>demo.sh</exclude>
      </excludes>
    </fileSet>
  </fileSets>
  <files>
    <file>
      <source>${project.build.directory}/insight-brain-service-${project.version}-server.jar</source>
      <outputDirectory>.</outputDirectory>
      <destName>${clm.server.jar}</destName>
    </file>
    <file>
      <source>${maven.multiModuleProjectDirectory}/jvm.options</source>
      <outputDirectory>.</outputDirectory>
    </file>
    <!-- 
      Flip executable bit for demo bash script.
      
      NOTE: The order of execution between a fileSet and a files collection is indeterminate
            so it must be excluded from the fileSet to ensure that this flag is set.
    -->
    <file>
      <source>src/main/filtered-resources/demo.sh</source>
      <outputDirectory>.</outputDirectory>
      <filtered>true</filtered>
      <fileMode>744</fileMode>
    </file>
  </files>
</assembly>
