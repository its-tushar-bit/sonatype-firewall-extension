@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

def updateMain = false

pipeline {
  agent { label InsightConstants.AGENT_LABEL }

  parameters {
    string(name: 'RELEASE_BRANCH_NAME', defaultValue: 'release-1.XXX.x', description: 'Name of the release branch to create (e.g., release-1.199.x). Build number is appended during aggregate-release.')
    string(name: 'START_POINT', defaultValue: 'main', description: 'Source branch or commit SHA to create the release branch from')
    string(name: 'DEFAULT_BRANCH', defaultValue: 'main', description: 'Target branch to bump version on after release branch is created (typically main)')
    string(name: 'NEXT_VERSION', defaultValue: '1.XXX.0-SNAPSHOT', description: 'Next development version to set on DEFAULT_BRANCH (e.g., 1.200.0-SNAPSHOT). Leave empty to skip version bump.')
  }

  stages {
    stage('Pre requirements') {
      steps {
        script {
          // Set updateMain based on NEXT_VERSION parameter
          updateMain = NEXT_VERSION?.trim()?.length() > 0

          if (!RELEASE_BRANCH_NAME?.trim()) {
            error 'RELEASE_BRANCH_NAME is required'
          }
          if (updateMain && !DEFAULT_BRANCH?.trim()) {
            error 'DEFAULT_BRANCH is required when NEXT_VERSION is provided'
          }
          setBuildDisplayName([Branch: RELEASE_BRANCH_NAME])
        }

        runSafely 'git config --global push.default simple'
        runSafely "git config user.email 'sonatype-zion@sonatype.com'"
        runSafely "git config user.name 'Sonatype Zion'"

        script {
          // Check if release branch already exists remotely before making any changes
          sshagent(credentials: [sonatypeZionCredentialsId()]) {
            def remoteBranchCheck = sh(script: "git ls-remote --heads origin ${RELEASE_BRANCH_NAME}", returnStdout: true).trim()
            if (!remoteBranchCheck.isEmpty()) {
              error "Release branch '${RELEASE_BRANCH_NAME}' already exists on remote"
            }
          }

          // Check if version update would actually change pom.xml files
          if (updateMain) {
            runSafely "git checkout ${DEFAULT_BRANCH}"
            def currentVersion = null
            withMaven(jdk: 'OpenJDK 17', maven: 'Maven 3.9.x', mavenSettingsConfig: 'private-settings.xml') {
              currentVersion = sh(script: "mvn help:evaluate -Dexpression=project.version -q -DforceStdout | tail -1", returnStdout: true).trim()
            }
            echo "Current version on ${DEFAULT_BRANCH}: ${currentVersion}, Next version: ${NEXT_VERSION}"
            if (currentVersion == NEXT_VERSION) {
              error "Current version (${currentVersion}) is already set to ${NEXT_VERSION}. No version change needed."
            }
          }
        }
      }
    }

    stage('Create release branch') {
      steps {
        runSafely "git checkout ${START_POINT}"
        runSafely "git checkout -b ${RELEASE_BRANCH_NAME} ${START_POINT}"
      }
    }

    stage('Set development version') {
      when {
        expression { updateMain }
      }
      steps {
        runSafely "git checkout ${DEFAULT_BRANCH}"
        withMaven(jdk: 'OpenJDK 17', maven: 'Maven 3.9.x', mavenSettingsConfig: 'private-settings.xml') {
          runSafely "./set-version.sh ${NEXT_VERSION}"
        }

        script {
          def pomChanges = sh(script: 'git diff --name-only -- "*.xml" | grep pom.xml || true', returnStdout: true).trim()
          if (pomChanges.isEmpty()) {
            error "No pom.xml files were modified. Version may already be set to ${NEXT_VERSION}"
          }
          echo "Modified pom.xml files:\n${pomChanges}"
        }

        gitCommit("Bump version to: ${NEXT_VERSION}")
      }
    }

    stage('Push release branch') {
      steps {
        sshagent(credentials: [sonatypeZionCredentialsId()]) {
          runSafely "git push -u origin ${RELEASE_BRANCH_NAME}"
        }
      }
    }

    stage('Push development version') {
      when {
        expression { updateMain }
      }
      steps {
        sshagent(credentials: [sonatypeZionCredentialsId()]) {
          runSafely "git checkout ${DEFAULT_BRANCH} && git pull --rebase"
          runSafely "git push -u origin ${DEFAULT_BRANCH}"
        }
      }
    }
  }
  post {
    always {
      cleanWs()
    }
  }
}

private void gitCommit(commitMessage) {
  sshagent(credentials: [sonatypeZionCredentialsId()]) {
    runSafely 'git add -u'
    // Don't perform commit if no changes.
    runSafely "git diff-index --quiet HEAD || git commit -m \"${commitMessage}\""
  }
}
