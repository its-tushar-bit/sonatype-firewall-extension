@Library(['private-pipeline-library', 'jenkins-shared', 'bnr-pipeline-library', 'iq-pipeline-library']) _
pipeline {
  agent { label InsightConstants.AGENT_LABEL }
  environment {
    minorVersion = "${parseVersion(getVersionFromBuildName(env.releaseBuild_NAME))?.minor}"
  }
  tools {
    jdk 'Java 8'
  }
  options {
    buildDiscarder(
        logRotator(numToKeepStr: '100', artifactNumToKeepStr: '20')
    )
    timestamps()
  }
  stages {
    stage('Export Variables') {
      steps {
        exportBuildVariables(params.environment, env.releaseBuild_NAME)
      }
    }
    stage('Checkout Publishing Scripts') {
      steps {
        checkoutPublishingScripts()
      }
    }
    stage('Gather Build Artifacts') {
      steps {
        gatherBuildArtifacts('insight/insight-brain/release', env.releaseBuild_NUMBER)
      }
    }
    stage('Publish Server') {
      steps {
        publishProduct('IQServer')
      }
    }
    stage('Publish CLI Scanner') {
      steps {
        publishProduct('CLIScanner')
      }
    }
    stage('Build and push internal RPM') {
      when {
        expression {'Staging' == params?.environment}
      }
      steps {
        dir('iq-server-rpm') {
          git(url: 'git@github.com:sonatype/iq-server-rpm.git', branch: 'master',
              credentialsId: 'a046da04-58b6-4f2a-894c-7b7dcd83004e')
          runSafely "make -f Makefile.bamboo -e VERSION=${getVersionFromBuildName(env.releaseBuild_NAME)} rpm"
          archiveArtifacts artifacts: 'build/rpmbuild/RPMS/noarch/*.rpm'
          publishRpm()
        }
      }
    }
    stage('Update iq-server latest version') {
      steps {
        updateLatestVersionTable(params.environment, 'IQ_SERVER', getVersionFromBuildName(env.releaseBuild_NAME))
      }
    }
    stage('Update iq-cli latest version') {
      steps {
        updateLatestVersionTable(params.environment, 'IQ_CLI', getVersionFromBuildName(env.releaseBuild_NAME))
      }
    }
    stage('Update nginx configuration') {
      steps {
        updateNginxConfig(params.environment)
      }
    }
    stage('Purge Fastly Download Cache') {
      steps {
        build job: 'ops/fastly-purge-downloads', propagate: true, wait: true
      }
    }
    stage('Update Download and Compatibility Page') {
      when {
        expression {'Production' == params?.environment}
      }
      steps {
        updateDownloadPage(env.minorVersion)
      }
    }
  }
  post {
    always {
      notifyChat(currentBuild: currentBuild, env: env, room: 'ops-builds')
      deleteDir()
    }
  }
}
