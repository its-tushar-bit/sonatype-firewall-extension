                    </structure>
                    <structure>
                        <property name="position">3</property>
                        <property name="name">overriddenLicenses</property>
                        <property name="dataType">javaObject</property>
                    </structure>
                    <structure>
                        <property name="position">4</property>
                        <property name="name">effectiveLicenseThreat</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">5</property>
                        <property name="name">color</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">6</property>
                        <property name="name">score</property>
                        <property name="dataType">integer</property>
                    </structure>
                    <structure>
                        <property name="position">7</property>
                        <property name="name">status</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">8</property>
                        <property name="name">format</property>
                        <property name="dataType">string</property>
                    </structure>
                    <structure>
                        <property name="position">9</property>
                        <property name="name">displayName</property>
                        <property name="dataType">string</property>
                    </structure>
                </list-property>
            </structure>
            <property name="dataSource">licenses</property>
            <method name="open"><![CDATA[index = 0;
]]></method>
            <method name="fetch"><![CDATA[if (index >= licenses.length) {
	return false;
}

var lic = licenses[index];

if (lic.overriddenLicenses) {
	row["overriddenLicenses"] = lic.overriddenLicenses;
	row["declaredLicenses"] = [];
	row["observedLicenses"] = [];
} else {
	var dedup = [];
	for (i = 0; i < lic.observedLicenses.length; i++) {
		if ("Not Provided" === lic.observedLicenses[i] || lic.declaredLicenses.indexOf(lic.observedLicenses[i]) < 0) {
			dedup.push(lic.observedLicenses[i]);
		}
	}
	row["overriddenLicenses"] = [];
	row["declaredLicenses"] = lic.declaredLicenses;
	row["observedLicenses"] = dedup;
}

var threat = lic.effectiveLicenseThreat;
row["effectiveLicenseThreat"] = threat;
if (threat > 7) {
	row["color"] = "red";
	row["score"] = 30;
} else if (threat > 3) {
	row["color"] = "orange";
	row["score"] = 20;
} else if (threat > 0) {
	row["color"] = "yellow";
	row["score"] = 25;
} else if (threat == 0) {
	row["color"] = "blue";
	row["score"] = 10;
} else {
	row["color"] = "grey";
	row["score"] = 0;
}

row["status"] = lic.status ? lic.status : "Open";

row["displayName"] = getDisplayName(lic);
row["format"] = getFormat(lic);

index++;

return true;
]]></method>
        </script-data-set>
