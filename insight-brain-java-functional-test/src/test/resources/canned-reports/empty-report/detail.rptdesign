            <property name="dataSource">summary</property>
            <method name="open"><![CDATA[index = 0;
]]></method>
            <method name="fetch"><![CDATA[if (index >= 1) {
	return false;
}

row["exceededRowLimit"] = summary.exceededRowLimit;

row["submitter"] = summary.submitter;
row["recipient"] = summary.recipient;
row["reportUrl"] = summary.reportUrl ? summary.reportUrl + "?referrer=pdf" : null;
row["scanTime"] = new Date(parseInt(summary.reportTime));
row["reportTime"] = new Date();
row["scanLabel"] = summary.scanLabel;
row["buildLabel"] = summary.applicationName ? summary.applicationName + ", " + summary.stageName : null; // applicationName will be NULL on versions < 1.12.1
row["applicationContactName"] = summary.applicationContactName;
row["applicationContactEmail"] = summary.applicationContactEmail;
row["scannerVersion"] = summary.scannerVersion;
row["totalArtifactCount"] = summary.totalArtifactCount;
row["knownArtifactCount"] = summary.knownArtifactCount;

// @since Brain 1.2
if (data.policyCounts) {
	row["policyComponentCount"] = data.policyComponentCount;
	row["criticalPolicyCount"] = data.policyCounts[8] + data.policyCounts[9] + data.policyCounts[10];
	row["severePolicyCount"] = data.policyCounts[4] + data.policyCounts[5] + data.policyCounts[6] + data.policyCounts[7];
	row["moderatePolicyCount"] = data.policyCounts[2] + data.policyCounts[3];
}

row["insecureArtifactCount"] = data.insecureArtifactCount;
row["criticalSecurityCount"] = data.securityCounts[0] + data.securityCounts[1] + data.securityCounts[2] + data.securityCounts[3];
row["severeSecurityCount"] = data.securityCounts[4] + data.securityCounts[5] + data.securityCounts[6];
row["moderateSecurityCount"] = data.securityCounts[7] + data.securityCounts[8] + data.securityCounts[9];
row["securityCount"] = row["moderateSecurityCount"] + row["severeSecurityCount"] + row["criticalSecurityCount"];
row["totalSecurityAlertCount"] = row["securityCount"];

row["criticalLicenseCount"] = data.effectiveLicenseCounts[8] + data.effectiveLicenseCounts[9] + data.effectiveLicenseCounts[10];
row["severeLicenseCount"] = data.effectiveLicenseCounts[4] + data.effectiveLicenseCounts[5] + data.effectiveLicenseCounts[6] + data.effectiveLicenseCounts[7];
row["moderateLicenseCount"] = data.effectiveLicenseCounts[1] + data.effectiveLicenseCounts[2] + data.effectiveLicenseCounts[3];
row["noThreatLicenseCount"] = data.effectiveLicenseCounts[0];
row["totalLicenseAlertCount"] = row["criticalLicenseCount"] + row["severeLicenseCount"] + row["moderateLicenseCount"];
row["licenseCount"] = row["totalLicenseAlertCount"] + row["noThreatLicenseCount"];

row["grandfatheredPolicyViolationCount"] = data.grandfatheredPolicyViolationCount;

row["securityDepth"] = data.securityPunchCard.length;
row["licenseDepth"] = data.licensePunchCard.length;

index++;

return true;
]]></method>
        </script-data-set>
