{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["jest", "@testing-library/jest-dom"],
    "baseUrl": ".",
    "paths": {
      "GuideRoot/*": ["src/main/frontend/guide/*"]
    }
  },
  "include": [
    "src/main/frontend/guide/**/*.ts",
    "src/main/frontend/guide/**/*.tsx",
    "src/test/frontend/guide/**/*.ts",
    "src/test/frontend/guide/**/*.tsx"
  ]
}
