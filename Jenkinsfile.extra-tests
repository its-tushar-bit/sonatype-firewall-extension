@Library(['private-pipeline-library', 'jenkins-shared', 'iq-pipeline-library']) _

String agentLabel = InsightConstants.AGENT_LABEL

def testConfig(String mavenOptions, String pomFile = null, String javaVersion = 'Java 8') {
  return mavenCommon(javaVersion: javaVersion, mavenVersion: 'Maven 3.6.x', useEventSpy: false,
      pomFile: pomFile, mavenOptions: mavenOptions)
}

def copyRepo() {
  copyArtifacts(projectName: currentBuild.upstreamBuilds[0].fullProjectName,
    filter: '.zion/repository/**',
    selector: specific(currentBuild.upstreamBuilds[0].id),
    flatten: false)
}

def gebTests() {
  copyRepo()
  String mavenOptions = "-Dgeb.env=ci -Drun-functional-tests=docker -Ddocker.registry=${sonatypeDockerRegistryId()}"

  def testConfig = testConfig(mavenOptions, 'insight-brain-functional-test/pom.xml')
  mvn testConfig, 'clean verify'
}

def functionalTests(String browser, String testRegex, String testGroupLabel) {
  copyRepo()
  withCredentials([string(credentialsId: 'APPLITOOLS_KEY', variable: 'applitoolsKey')]) {
    String mavenOptions = "'-Dit.test=%regex[${testRegex}]'"
    mavenOptions += " -Dtest.group=${testGroupLabel}"
    mavenOptions += ' -Drun-functional-tests=docker'
    mavenOptions += " -Dbrowser=${browser}"
    mavenOptions += " -DapplitoolsKey=${applitoolsKey}"
    mavenOptions += " -Ddocker.registry=${sonatypeDockerRegistryId()}"
    def testConfig = testConfig(mavenOptions, 'insight-brain-java-functional-test/pom.xml')
    mvn testConfig, 'clean verify'
  }
}

def unitTests(String testRegex, String javaVersion = 'Java 8') {
  def testConfig = testConfig(
      "-Dtest=%regex[${testRegex}] -Dit.test=%regex[${testRegex}] -Dskip-functional-test " +
          "-Ddocker.registry=${sonatypeDockerRegistryId()} -Pbuildsupport-sonar-coverage",
      null, javaVersion)
  mvn testConfig, 'clean install'
}

def captureResultsAndCleanup(String artifactGlob = '**/target/*-reports/**') {
  archiveArtifacts(artifacts: artifactGlob, excludes: '**/*.xml, **/*-output.txt')
  collectTestResults(['**/target/*-reports/*.xml'])
  deleteDir()
}

def checkIfJiraNeeded() {
  // Only create the ticket on master and main failures.
  if (currentBuild.currentResult != 'SUCCESS' && (currentBuild.fullProjectName.contains('master') || currentBuild.fullProjectName.contains('main'))) {
    echo "The build is entering the unstable condition to create a jira ticket, current build #: ${currentBuild.displayName} ${currentBuild.number}"
    createJiraTicket()
  } else if (currentBuild.currentResult != 'SUCCESS') {
    echo "The build is unstable but this is not on the main or master branch - no jira ticket is created as a result."
  }
}

def createJiraTicket() {
  def jiraCredentialId = 'clm-jenkins'

  def commits = getBuildRecentCommits(currentBuild)

  def commitMsg = ''
  if (commits.size() > 0) {
    commitMsg = commits[0].replace("\n", "\\n")
    def newNext = """
    {
        "fields": {
           "project":
           {
              "key": "CLM"
           },
           "labels": [
                "master-build-failure"
            ],
           "summary": "Failure of Insight Brain Extra Tests Build ${currentBuild.displayName}",
           "description": "This build had a failure. Please fix the failure and rebuild: ${currentBuild.absoluteUrl}. The latest commit is: $commitMsg",
           "issuetype": {
              "id": "1"
           }
        }
    }
    """

    def newResponse = httpRequest url: "https://issues.sonatype.org/rest/api/2/issue/",
      httpMode: 'POST',
      requestBody: newNext,
      acceptType: 'APPLICATION_JSON',
      contentType: 'APPLICATION_JSON',
      authentication: jiraCredentialId,
      validResponseCodes: '100:404'
    if (newResponse.status != 201) {
        echo 'Status: '+newResponse.status
        echo 'Response: '+newResponse.content
        error("Failed to create a new ticket")
    } else {
        echo 'Response: '+newResponse.content
    }
  } else {
        echo 'Commit message was empty - no tickets will be created'
  }
}

pipeline {
  agent none
  options {
    buildDiscarder(
        logRotator(numToKeepStr: '100', daysToKeepStr: '14', artifactNumToKeepStr: '20', artifactDaysToKeepStr: '10')
    )
    timestamps()
  }
  stages {
    stage('Parallel Test Groups') {
      parallel {
        stage('Geb Functional Tests') {
          agent { label agentLabel }
          steps {
            gebTests()
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Java Functional Tests - (Chrome) A') {
          agent { label agentLabel }
          environment {
            // For the applitools github integration
            APPLITOOLS_BATCH_ID = "${env.GIT_COMMIT}"
          }
          steps {
            functionalTests('chrome', '.*/[A-H].*Test.class', 'chrome-A')
          }
          post {
            always {
              captureResultsAndCleanup('**/target/*-reports/**,**/*docker.log')
            }
          }
        }
        stage('Java Functional Tests - (Chrome) B') {
          agent { label agentLabel }
          environment {
            // For the applitools github integration
            APPLITOOLS_BATCH_ID = "${env.GIT_COMMIT}"
          }
          steps {
            functionalTests('chrome', '.*/[I-R].*Test.class', 'chrome-B')
          }
          post {
            always {
              captureResultsAndCleanup('**/target/*-reports/**,**/*docker.log')
            }
          }
        }
        stage('Java Functional Tests - (Chrome) C') {
          agent { label agentLabel }
          environment {
            // For the applitools github integration
            APPLITOOLS_BATCH_ID = "${env.GIT_COMMIT}"
          }
          steps {
            functionalTests('chrome', '.*/[S-Z].*Test.class', 'chrome-C')
          }
          post {
            always {
              captureResultsAndCleanup('**/target/*-reports/**,**/*docker.log')
            }
          }
        }
        stage('Unit and Integration Tests - Java8 A') {
          agent { label agentLabel }
          steps {
            unitTests('.*/[A-H].*Test.class')
          }
          post {
            always {
              sonarAnalyze(env: env, sonarAnalysisPullRequestsOnly: currentBuild.projectName != 'master')
              captureResultsAndCleanup()
            }
          }
        }
        stage('Unit and Integration Tests - Java8 B') {
          agent { label agentLabel }
          steps {
            unitTests('.*/[I-P].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Unit and Integration Tests - Java8 C') {
          agent { label agentLabel }
          steps {
            unitTests('.*/[Q-Z].*Test.class')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Unit and Integration Tests - Java11 A') {
          agent { label agentLabel }
          steps {
            unitTests('.*/[A-H].*Test.class','OpenJDK 11')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Unit and Integration Tests - Java11 B') {
          agent { label agentLabel }
          steps {
            unitTests('.*/[I-P].*Test.class','OpenJDK 11')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
        stage('Unit and Integration Tests - Java11 C') {
          agent { label agentLabel }
          steps {
            unitTests('.*/[Q-Z].*Test.class','OpenJDK 11')
          }
          post {
            always {
              captureResultsAndCleanup()
            }
          }
        }
      }
    }
  }
  post {
      always {
          checkIfJiraNeeded()
      }
  }
}
